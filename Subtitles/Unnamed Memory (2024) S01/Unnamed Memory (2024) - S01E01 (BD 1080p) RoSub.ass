Comment: 0,0:00:00.00,0:00:00.02,Dialogue,chptr,0,0,0,,{Prolog}
Comment: 0,0:01:02.96,0:01:03.00,Dialogue,chptr,0,0,0,,{OP}
Comment: 0,0:02:33.01,0:02:33.05,Dialogue,chptr,0,0,0,,{Partea I}
Comment: 0,0:09:29.13,0:09:29.17,Dialogue,chptr,0,0,0,,{Partea a II-a}
