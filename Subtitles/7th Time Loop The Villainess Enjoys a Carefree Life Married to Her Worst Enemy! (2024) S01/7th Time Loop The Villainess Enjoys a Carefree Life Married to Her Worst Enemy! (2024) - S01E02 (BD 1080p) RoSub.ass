Dialogue: 0,0:00:56.24,0:01:00.73,OP TL,,0,0,0,,În această călătorie fără sfârșit,
Dialogue: 0,0:01:01.58,0:01:04.81,OP TL,,0,0,0,,îmi încep diminețile repetitive
Dialogue: 0,0:01:05.15,0:01:08.94,OP TL,,0,0,0,,prin a-mi freca ochii adormiți
Dialogue: 0,0:01:09.48,0:01:14.37,OP TL,,0,0,0,,Niji ou watari toritachi
Dialogue: 0,0:01:14.86,0:01:18.40,OP TL,,0,0,0,,Bokura wa nita mono doushi sa
Dialogue: 0,0:01:18.77,0:01:21.91,OP TL,,0,0,0,,Koko de nai dokoka e
Dialogue: 0,0:01:22.31,0:01:25.59,OP TL,,0,0,0,,Unmei no sono ito tachikire
Dialogue: 0,0:01:25.63,0:01:30.18,OP TL,,0,0,0,,Nee motto jiyuu ni daitan ni asobe
Dialogue: 0,0:01:30.57,0:01:35.88,OP TL,,0,0,0,,Ima wo ichibyo demo kaki kaete
Dialogue: 0,0:01:36.17,0:01:37.02,OP TL,,0,0,0,,"Negattara..."
Dialogue: 0,0:01:37.19,0:01:43.37,OP TL,,0,0,0,,Kyou to iu asa kara arata na hikari ga hajimaru
Dialogue: 0,0:01:43.73,0:01:46.80,OP TL,,0,0,0,,Me no mae ni rin to tomotta
Dialogue: 0,0:01:46.86,0:01:50.26,OP TL,,0,0,0,,Sono subete mou hitotsu no baasudee
Dialogue: 0,0:01:50.43,0:01:56.65,OP TL,,0,0,0,,Toumei na shoudou dareka no unmeiron de nigosuna
Dialogue: 0,0:01:56.87,0:01:59.90,OP TL,,0,0,0,,Strâpunge cu încredere dincolo de punct
Dialogue: 0,0:02:00.18,0:02:05.03,OP TL,,0,0,0,,Deoarece putem schimba viitorul
