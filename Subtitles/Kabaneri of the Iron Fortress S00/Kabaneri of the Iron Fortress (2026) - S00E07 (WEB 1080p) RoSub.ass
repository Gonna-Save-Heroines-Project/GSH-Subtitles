Dialogue: 0,0:04:55.59,0:04:58.61,Song TL,,0,0,0,,Don't be above your daydream
Dialogue: 0,0:04:58.77,0:05:01.76,Song TL,,0,0,0,,Take your point of vision
Dialogue: 0,0:05:01.90,0:05:07.40,Song TL,,0,0,0,,Chiar dacă-ți vezi visul trecând pe lângă tine,
Dialogue: 0,0:05:07.50,0:05:12.67,Song TL,,0,0,0,,Eu voi trece podul cântând,
Dialogue: 0,0:05:13.08,0:05:18.86,Song TL,,0,0,0,,Ca să las tăcerea să răsune
Dialogue: 0,0:05:23.17,0:05:27.75,Song TL,,0,0,0,,Nu te teme, soarele tocmai răsare
Dialogue: 0,0:05:28.75,0:05:33.34,Song TL,,0,0,0,,Nu te teme, soarele tocmai răsare
