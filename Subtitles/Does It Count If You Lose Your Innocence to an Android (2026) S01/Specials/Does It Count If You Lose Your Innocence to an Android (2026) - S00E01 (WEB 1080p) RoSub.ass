Comment: 0,0:00:00.00,0:00:00.02,Dialogue,chptr,0,0,0,,{Episod}
Dialogue: 99,0:00:02.98,0:00:05.69,Dialogue,Akane,0,0,0,,V-Vrei să facem sex
Dialogue: 99,0:00:05.69,0:00:08.24,Dialogue,Akane,0,0,0,,cinci zile la rând?!
Dialogue: 99,0:00:08.24,0:00:09.43,Dialogue,Nadeshiko,0,0,0,,Da.
Dialogue: 99,0:00:09.43,0:00:13.74,Dialogue,Nadeshiko,0,0,0,,Nu e ăsta cel mai bun mod \Nde a-ți petrece concediul?
Dialogue: 99,0:00:13.74,0:00:15.94,Dialogue,Akane,0,0,0,,Dar mai avem nevoie și să mâncăm, nu?
Dialogue: 99,0:00:15.94,0:00:18.99,Dialogue,Nadeshiko,0,0,0,,Nu vom face sex nonstop.
Dialogue: 99,0:00:18.99,0:00:21.13,Dialogue,Nadeshiko,0,0,0,,Spre exemplu, vom începe cu...
Dialogue: 99,0:00:22.63,0:00:24.13,Dialogue,Nadeshiko,0,0,0,,Îmbrățișări
Dialogue: 99,0:00:24.72,0:00:27.38,Dialogue,Nadeshiko,0,0,0,,și ținut de mână.
Dialogue: 99,0:00:27.64,0:00:31.90,Dialogue,Nadeshiko,0,0,0,,În primele patru zile ne vom concentra asupra \Npreludiului și vom păstra sexul pentru ultima zi.
Dialogue: 99,0:00:32.99,0:00:35.99,Dialogue,Nadeshiko,0,0,0,,Cred că acest concediu \Nva fi unul memorabil.
Dialogue: 99,0:00:35.99,0:00:38.02,Dialogue,Akane,0,0,0,,Ah, înțeleg.
Dialogue: 99,0:00:39.02,0:00:42.91,Dialogue,Akane,0,0,0,,Nadeshiko, tu ai fi \Nfericită dacă am face asta?
Dialogue: 99,0:00:42.91,0:00:45.02,Dialogue,Nadeshiko,0,0,0,,Desigur.
Dialogue: 99,0:00:45.56,0:00:48.96,Dialogue,Akane,0,0,0,,În regulă. Atunci, așa vom face.
Dialogue: 99,0:00:48.96,0:00:49.73,Dialogue,Nadeshiko,0,0,0,,Bine!
Dialogue: 99,0:00:52.65,0:00:55.64,Dialogue,Nadeshiko,0,0,0,,Vom începe prin a ne \Narăta afecțiunea astăzi.
Dialogue: 99,0:00:55.64,0:00:57.66,Dialogue,Akane,0,0,0,,{\i1}M-a pus la perete?
Comment: 99,0:00:57.66,0:01:02.67,Dialogue,Nadeshiko,0,0,0,,{\an8}missing line
Dialogue: 99,0:00:57.95,0:01:01.28,Dialogue,Akane,0,0,0,,{\i1}Nimeni nu mi-a mai \Nfăcut asta până acum.
Dialogue: 99,0:01:01.28,0:01:02.67,Dialogue,Akane,0,0,0,,{\i1}Este...
Dialogue: 99,0:01:03.92,0:01:05.53,Dialogue,Akane,0,0,0,,{\i1}Este așa de drăguță.
Dialogue: 99,0:01:11.55,0:01:14.18,Dialogue,Akane,0,0,0,,{\i1}Se simte diferit de cum \Nne sărutăm de obicei.
Dialogue: 99,0:01:17.47,0:01:19.18,Dialogue,Akane,0,0,0,,Astăzi doar ne vom săruta?
Dialogue: 99,0:01:19.96,0:01:20.79,Dialogue,Nadeshiko,0,0,0,,Da.
Dialogue: 99,0:01:22.52,0:01:25.16,Dialogue,Akane,0,0,0,,{\i1}Nu prea știam la ce să \Nmă aștept la început,
Dialogue: 99,0:01:25.16,0:01:28.24,Dialogue,Akane,0,0,0,,{\fad(0,400)\i1}dar nu e rău deloc \Ns-o luăm ușor ca acum.
Dialogue: 99,0:01:30.30,0:01:32.07,Dialogue,Akane,0,0,0,,N-Nadeshiko!
Dialogue: 99,0:01:32.61,0:01:36.08,Dialogue,Akane,0,0,0,,Ai spus că vom păstra \Nasta pentru ultima zi!
Dialogue: 99,0:01:37.70,0:01:40.27,Dialogue,Nadeshiko,0,0,0,,Ei bine, nu avem voie să \Nne atingem sub talie astăzi,
Dialogue: 99,0:01:40.27,0:01:43.60,Dialogue,Nadeshiko,0,0,0,,așa că mă voi mulțumi \Ncu partea ta superioară.
Dialogue: 99,0:01:47.24,0:01:49.22,Dialogue,Akane,0,0,0,,{\fad(0,400)}Nadeshiko! Te rog!
Dialogue: 99,0:01:50.21,0:01:52.14,Dialogue,Nadeshiko,0,0,0,,Bun! Asta e tot pentru astăzi.
Dialogue: 99,0:01:53.50,0:01:56.49,Dialogue,Nadeshiko,0,0,0,,Am spus că vom păstra punctul \Nculminant pentru ultima zi, nu?
Dialogue: 99,0:01:56.49,0:01:58.07,Dialogue,Akane,0,0,0,,{\i1}Ce? Dar...
Dialogue: 99,0:02:01.55,0:02:03.77,Dialogue,Akane,0,0,0,,{\i1}Sunt mult prea excitată \Nca să pot dormi!
Dialogue: 99,0:02:08.07,0:02:11.34,Dialogue,Nadeshiko,0,0,0,,Astăzi ne vom concentra \Npe zona inferioară, bine?
Dialogue: 99,0:02:11.34,0:02:12.25,Dialogue,Akane,0,0,0,,Ce?!
Dialogue: 99,0:02:12.25,0:02:13.83,Dialogue,Nadeshiko,0,0,0,,Spre exemplu:
Dialogue: 99,0:02:13.83,0:02:15.27,Dialogue,Nadeshiko,0,0,0,,mângâiatul coapselor,
Dialogue: 99,0:02:16.25,0:02:17.97,Dialogue,Nadeshiko,0,0,0,,al stomacului
Dialogue: 99,0:02:18.49,0:02:20.87,Dialogue,Nadeshiko,0,0,0,,sau doar atingeri ușoare.
Dialogue: 99,0:02:24.44,0:02:28.58,Dialogue,Akane,0,0,0,,{\i1}Știam eu. Doar mă va stârni din nou.
Dialogue: 99,0:02:28.58,0:02:30.89,Dialogue,Akane,0,0,0,,{\i1}Dacă se simte atât de bine acum,
Dialogue: 99,0:02:30.89,0:02:33.79,Dialogue,Akane,0,0,0,,{\fad(0,350)\i1}oare cum va fi mâine?
Dialogue: 99,0:02:35.65,0:02:36.89,Dialogue,Nadeshiko,0,0,0,,Bun,
Dialogue: 99,0:02:37.41,0:02:40.52,Dialogue,Nadeshiko,0,0,0,,ești pregătită, Akane?
Dialogue: 99,0:02:42.35,0:02:45.02,Dialogue,Akane,0,0,0,,{\i1}Sunt așa nefutută încât \Nnu am închis un ochi!
Dialogue: 99,0:02:46.02,0:02:47.02,Dialogue,Nadeshiko,0,0,0,,Bun.
Dialogue: 99,0:02:47.30,0:02:48.82,Dialogue,Nadeshiko,0,0,0,,Să începem.
Dialogue: 99,0:02:53.28,0:02:55.78,Dialogue,Akane,0,0,0,,{\i1}Un singur deget m-a \Nfăcut să am orgasm?!
Dialogue: 99,0:02:56.96,0:02:58.24,Dialogue,Nadeshiko,0,0,0,,Akane?
Dialogue: 99,0:03:00.39,0:03:02.79,Dialogue,Nadeshiko,0,0,0,,Scuze că te-am făcut să aștepți atâta,
Dialogue: 99,0:03:02.79,0:03:06.79,Dialogue,Nadeshiko,0,0,0,,dar va trebui să mai înduri puțin, bine?
Dialogue: 99,0:03:06.09,0:03:06.79,Dialogue Overlap,Akane,0,0,0,,Ce?!
Dialogue: 99,0:03:07.46,0:03:12.27,Dialogue,Nadeshiko,0,0,0,,În acest moment, chiar și cel mai mic \Nstimul îți va aduce o plăcere incredibilă.
Dialogue: 99,0:03:13.82,0:03:16.11,Dialogue,Nadeshiko,0,0,0,,Deci să nu ne grăbim ca să \Nai timp să te obișnuiești.
Dialogue: 99,0:03:19.24,0:03:20.51,Dialogue,Akane,0,0,0,,Nadeshiko...
Dialogue: 99,0:03:20.51,0:03:21.49,Dialogue,Nadeshiko,0,0,0,,Da?
Dialogue: 99,0:03:21.49,0:03:22.49,Dialogue,Akane,0,0,0,,Nadeshiko!
Dialogue: 99,0:03:22.49,0:03:24.15,Dialogue,Nadeshiko,0,0,0,,E în regulă.
Dialogue: 99,0:03:24.15,0:03:25.56,Dialogue,Akane,0,0,0,,Nadeshiko...
Dialogue: 99,0:03:25.56,0:03:28.28,Dialogue,Nadeshiko,0,0,0,,Vreau să te simți \Ncât mai bine posibil.
Dialogue: 99,0:03:41.11,0:03:42.79,Dialogue,Nadeshiko,0,0,0,,Hei, Akane...
Dialogue: 99,0:03:42.79,0:03:45.42,Dialogue,Nadeshiko,0,0,0,,Nu mai e nevoie să te abții.
Dialogue: 99,0:03:45.42,0:03:47.83,Dialogue,Nadeshiko,0,0,0,,Spune-mi ce îți dorești.
Dialogue: 99,0:03:49.33,0:03:51.46,Dialogue,Akane,0,0,0,,M-Mai mult...
Dialogue: 99,0:03:52.22,0:03:54.18,Dialogue,Akane,0,0,0,,Vreau să te simt mai mult!
Dialogue: 99,0:03:54.18,0:03:54.99,Dialogue,Nadeshiko,0,0,0,,Bine.
Dialogue: 99,0:03:57.10,0:04:00.18,Dialogue,Akane,0,0,0,,Voi lucra de acasă mâine...
Dialogue: 99,0:04:00.18,0:04:03.85,Dialogue,Nadeshiko,0,0,0,,Oh, îmi cer scuze! \NAm exagerat puțin, nu?
Dialogue: 99,0:04:05.57,0:04:08.76,Dialogue,Nadeshiko,0,0,0,,Oricum, sunt foarte \Nfericită în acest moment.
Dialogue: 99,0:04:08.76,0:04:12.77,Dialogue,Nadeshiko,0,0,0,,Simt că mi-am îndeplinit scopul.
Dialogue: 99,0:04:12.77,0:04:14.36,Dialogue,Akane,0,0,0,,Nadeshiko...
Dialogue: 99,0:04:14.83,0:04:18.12,Dialogue,Nadeshiko,0,0,0,,Da! Exact ca o mașină de spălat \Nsau un cuptor cu microunde!
Dialogue: 99,0:04:18.12,0:04:19.24,Dialogue,Akane,0,0,0,,Ce?
Dialogue: 99,0:04:19.56,0:04:23.80,Dialogue,Akane,0,0,0,,{\i1}Nadeshiko spune lucruri de \Nrobot din când în când.
Dialogue: 99,0:04:23.80,0:04:26.55,Dialogue,Akane,0,0,0,,{\i1}Se vede că mă place,
Dialogue: 99,0:04:26.55,0:04:29.98,Dialogue,Akane,0,0,0,,{\i1}dar oare o face deoarece \Nașa a fost programată?
Dialogue: 99,0:04:29.98,0:04:31.50,Dialogue,Nadeshiko,0,0,0,,Mi-a plăcut mult...
Dialogue: 99,0:04:31.82,0:04:36.62,Dialogue,Nadeshiko,0,0,0,,Mi-ai rostit numele \Nde foarte multe ori.
Dialogue: 99,0:04:36.62,0:04:40.76,Dialogue,Nadeshiko,0,0,0,,De fiecare dată când o faci, \Nsimt fluturi în stomac.
Dialogue: 99,0:04:41.15,0:04:44.53,Dialogue,Nadeshiko,0,0,0,,Mă bucur că l-ai rostit \Nde așa multe ori astăzi.
Dialogue: 99,0:04:46.99,0:04:47.89,Dialogue,Akane,0,0,0,,Bine.
Dialogue: 99,0:04:48.67,0:04:50.41,Dialogue,Akane,0,0,0,,{\i1}Bănuiesc...
Dialogue: 99,0:04:50.41,0:04:52.73,Dialogue,Akane,0,0,0,,{\i1}că nu trebuie să-mi bat \Ncapul cu asta deocamdată.
