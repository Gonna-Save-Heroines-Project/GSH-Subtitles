Comment: 0,0:00:00.00,0:00:00.02,Dialogue,chptr,0,0,0,,{Episod}
Dialogue: 99,0:00:00.91,0:00:02.23,Dialogue,Akane,0,0,0,,M-am întors.
Dialogue: 99,0:00:02.23,0:00:04.98,Dialogue,Nadeshiko,0,0,0,,Bine ai revenit, Akane.
Dialogue: 99,0:00:04.98,0:00:07.61,Dialogue,Nadeshiko,0,0,0,,Ai tot stat peste program în \Nultima vreme. Ești în regulă?
Dialogue: 99,0:00:13.14,0:00:14.36,Dialogue,Nadeshiko,0,0,0,,Akane!
Dialogue: 99,0:00:15.52,0:00:17.20,Dialogue,Child Akane,0,0,0,,{\i1}Mami!
Dialogue: 99,0:00:17.20,0:00:18.60,Dialogue,Child Akane,0,0,0,,{\i1}Mami!
Dialogue: 99,0:00:19.15,0:00:22.86,Dialogue,Akane's Mom,0,0,0,,{\i1}E în regulă. Mami e lângă tine.
Dialogue: 99,0:00:22.86,0:00:24.55,Dialogue,Akane's Mom,0,0,0,,{\i1}Haide să te ștergem de traspirație.
Dialogue: 99,0:00:25.17,0:00:26.38,Dialogue,Akane's Mom,0,0,0,,{\i1}Gata.
Dialogue: 99,0:00:26.74,0:00:28.76,Dialogue,Akane,0,0,0,,Iei!
Dialogue: 99,0:00:29.88,0:00:33.00,Dialogue,Sakurako,0,0,0,,Ce? S-a suprasolicitat până a făcut o febră atât de mare
Dialogue: 99,0:00:33.00,0:00:35.36,Dialogue,Sakurako,0,0,0,,încât a regresat la stadiul de copil?
Dialogue: 99,0:00:35.36,0:00:36.64,Dialogue,Nadeshiko,0,0,0,,Da.
Dialogue: 99,0:00:37.34,0:00:41.02,Dialogue,Nadeshiko,0,0,0,,Mamă, cum poți repara un om?
Dialogue: 99,0:00:43.44,0:00:46.63,Dialogue,Sakurako,0,0,0,,Ei bine, probabil ar trebui să-i dai niște \Nmedicamente și s-o lași să se odihnească.
Dialogue: 99,0:00:50.31,0:00:53.20,Dialogue,Nadeshiko,0,0,0,,Acum că ți-ai luat tratamentul, \Ne timpul pentru somn.
Dialogue: 99,0:00:53.24,0:00:56.62,Dialogue,Akane,0,0,0,,Nu vreau! Nu-mi este somn!
Dialogue: 99,0:00:56.62,0:00:59.08,Dialogue,Akane,0,0,0,,Vreau să stau trează și să vorbim!
Dialogue: 99,0:01:03.27,0:01:05.48,Dialogue,Akane,0,0,0,,Povești în timp ce suntem goale!
Dialogue: 99,0:01:05.48,0:01:08.81,Dialogue,Akane,0,0,0,,Hei, hei, mami! Mă iubești?
Dialogue: 99,0:01:08.81,0:01:12.08,Dialogue,Nadeshiko,0,0,0,,Normal. Mai mult decât \Norice pe lumea asta.
Dialogue: 99,0:01:12.08,0:01:13.19,Dialogue,Akane,0,0,0,,Serios?
Dialogue: 99,0:01:13.90,0:01:15.77,Dialogue,Akane,0,0,0,,Și Akane te iubește.
Dialogue: 99,0:01:15.77,0:01:16.64,Dialogue,Akane,0,0,0,,Ce?
Dialogue: 99,0:01:17.34,0:01:20.04,Dialogue,Akane,0,0,0,,De ce sunt sânii mei \Natât de mari dintr-odată?
Dialogue: 99,0:01:21.24,0:01:23.44,Dialogue,Akane,0,0,0,,Și ai tăi sunt foarte mari, mami.
Dialogue: 99,0:01:23.44,0:01:25.26,Dialogue,Nadeshiko,0,0,0,,Îi poți atinge dacă vrei.
Dialogue: 99,0:01:25.26,0:01:26.61,Dialogue,Akane,0,0,0,,Serios?
Dialogue: 99,0:01:28.35,0:01:29.87,Dialogue,Akane,0,0,0,,Uau, sunt așa de moi.
Dialogue: 99,0:01:30.45,0:01:31.86,Dialogue,Nadeshiko,0,0,0,,Poți face mai mult decât să-i atingi.
Dialogue: 99,0:01:32.55,0:01:34.87,Dialogue,Nadeshiko,0,0,0,,Îi poți suge dacă vrei.
Dialogue: 99,0:01:35.14,0:01:36.69,Dialogue,Akane,0,0,0,,Nu!
Dialogue: 99,0:01:36.69,0:01:38.71,Dialogue,Akane,0,0,0,,Nu vreau să beau laptele lui mami!
Dialogue: 99,0:01:38.71,0:01:40.25,Dialogue,Akane,0,0,0,,Nu mai sunt un copil! Sunt...
Dialogue: 99,0:01:40.67,0:01:43.02,Dialogue,Akane,0,0,0,,Sunt... Sunt...
Dialogue: 99,0:01:43.02,0:01:44.23,Dialogue,Akane,0,0,0,,{\i1}Stai.
Dialogue: 99,0:01:44.23,0:01:46.14,Dialogue,Akane,0,0,0,,{\i1}De ce sunt...
Dialogue: 99,0:01:47.00,0:01:48.24,Dialogue,Akane,0,0,0,,{\i1}Așa este.
Dialogue: 99,0:01:48.24,0:01:51.99,Dialogue,Akane,0,0,0,,{\i1}Am răcit și am stat \Ntoată ziua cu mama.
Dialogue: 99,0:01:51.99,0:01:52.89,Dialogue,Akane,0,0,0,,{\i1}Da.
Dialogue: 99,0:01:53.83,0:01:55.15,Dialogue,Akane,0,0,0,,{\i1}Doar eu și mama...
Dialogue: 99,0:01:58.08,0:01:59.53,Dialogue,Akane,0,0,0,,Nadeshiko?
Dialogue: 99,0:02:01.25,0:02:04.07,Dialogue,Nadeshiko,0,0,0,,Ce ușurare.
Dialogue: 99,0:02:04.07,0:02:06.27,Dialogue,Akane,0,0,0,,Îmi pare foarte rău pentru \Ntoate probleme cauzate.
Dialogue: 99,0:02:07.62,0:02:11.49,Dialogue,Nadeshiko,0,0,0,,Bănuiesc că mama ta e o \Nfemeie foarte drăguță, Akane.
Dialogue: 99,0:02:12.16,0:02:14.91,Dialogue,Nadeshiko,0,0,0,,Sunt sigură că avea \Nmultă grijă de tine
Dialogue: 99,0:02:15.27,0:02:17.73,Dialogue,Nadeshiko,0,0,0,,și e clar că te iubea foarte mult.
Dialogue: 99,0:02:18.28,0:02:22.20,Dialogue,Nadeshiko,0,0,0,,Nu aș putea fi niciodată \No astfel de mamă.
Dialogue: 99,0:02:22.20,0:02:24.31,Dialogue,Akane,0,0,0,,Nu, nu era deloc așa.
Dialogue: 99,0:02:25.04,0:02:30.06,Dialogue,Akane,0,0,0,,Mama mea doar mi-ar \Nfi spus să dorm.
Dialogue: 99,0:02:30.06,0:02:32.30,Dialogue,Akane,0,0,0,,Nu era deloc tipul grijuliu.
Dialogue: 99,0:02:33.03,0:02:34.04,Dialogue,Akane,0,0,0,,De asta...
Dialogue: 99,0:02:35.70,0:02:38.55,Dialogue,Akane,0,0,0,,Mă bucur că mi-ai \Nfost alături, Nadeshiko.
Dialogue: 99,0:02:39.28,0:02:40.41,Dialogue,Akane,0,0,0,,Îți mulțumesc.
Dialogue: 99,0:02:44.02,0:02:46.06,Dialogue,Akane,0,0,0,,Deci, Nadeshiko,
Dialogue: 99,0:02:46.77,0:02:49.07,Dialogue,Akane,0,0,0,,în legătură cu \Nînregistrarea ca stăpân...
Dialogue: 99,0:02:51.78,0:02:56.48,Dialogue,Akane,0,0,0,,Nu-mi doresc să te \Ntratez ca pe un obiect,
Dialogue: 99,0:02:57.11,0:03:00.58,Dialogue,Akane,0,0,0,,dar îți promit că într-o bună zi voi găsi \Nun mod de a completa înregistrarea.
Dialogue: 99,0:03:01.20,0:03:06.08,Dialogue,Akane,0,0,0,,Așa că aș aprecia dacă ai \Nputea aștepta până atunci.
Dialogue: 99,0:03:08.61,0:03:09.50,Dialogue,Nadeshiko,0,0,0,,Desigur.
Dialogue: 99,0:03:13.90,0:03:18.10,Dialogue,Nadeshiko,0,0,0,,Eu voi continua să-mi perfecționez abilitațile sexuale până atunci.
Dialogue: 99,0:03:18.10,0:03:18.97,Dialogue,Akane,0,0,0,,Ce?
Dialogue: 99,0:03:19.58,0:03:20.71,Dialogue,Nadeshiko,0,0,0,,Noi două...
Dialogue: 99,0:03:21.26,0:03:23.01,Dialogue,Nadeshiko,0,0,0,,vom face atât de {\i1}multe{\i0} \Nlucruri împreună.
Dialogue: 99,0:03:24.19,0:03:25.48,Dialogue,Akane,0,0,0,,Da...
Dialogue: 99,0:03:26.14,0:03:28.34,Dialogue,Akane,0,0,0,,voi avea nevoie de niște \Ntimp să mă gândesc la asta.
