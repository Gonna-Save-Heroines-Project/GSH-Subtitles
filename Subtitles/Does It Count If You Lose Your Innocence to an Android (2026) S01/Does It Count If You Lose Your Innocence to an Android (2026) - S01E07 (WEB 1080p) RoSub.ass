Comment: 0,0:00:00.00,0:00:00.02,Dialogue,chptr,0,0,0,,{Episod}
Dialogue: 99,0:00:01.48,0:00:02.98,Dialogue,Nadeshiko,0,0,0,,Uau, privește.
Dialogue: 99,0:00:03.36,0:00:05.53,Dialogue,Nadeshiko,0,0,0,,Camerele sunt așa de variate.
Dialogue: 99,0:00:05.53,0:00:07.78,Dialogue,Akane,0,0,0,,Nu te entuziasma prea tare.
Dialogue: 99,0:00:07.78,0:00:08.36,Dialogue,Akane,0,0,0,,Ei bine,
Dialogue: 99,0:00:08.99,0:00:12.03,Dialogue,Akane,0,0,0,,nu aș spune că e profesionist să închiriezi \No camere la un hotel pentru cupluri.
Dialogue: 99,0:00:13.87,0:00:17.50,Dialogue,Akane,0,0,0,,{\i1}Mă simțeam prost s-o las acasă \Nîn timp ce eu eram plecată cu munca.
Dialogue: 99,0:00:15.79,0:00:17.50,Dialogue,Nadeshiko,0,0,0,,{\an8}Camera asta e superbă.
Dialogue: 99,0:00:17.87,0:00:20.83,Dialogue,Akane,0,0,0,,{\i1}Un hotel ieftin și \Nobișnuit ar fi fost de ajuns,
Dialogue: 99,0:00:20.83,0:00:24.17,Dialogue,Akane,0,0,0,,{\i1}dar acesta mă face să \Nmă simt puțin jenată.
Dialogue: 99,0:00:24.17,0:00:25.38,Dialogue,Akane,0,0,0,,{\i1}Of, fie!
Dialogue: 99,0:00:30.97,0:00:32.85,Dialogue,Akane,0,0,0,,Asta e perfect.
Dialogue: 99,0:00:32.85,0:00:36.02,Dialogue,Nadeshiko,0,0,0,,Îmi place să te văd fericită, Akane.
Dialogue: 99,0:00:36.77,0:00:40.81,Dialogue,Akane,0,0,0,,{\i1}Chiar nu are nicio legătură \Ncu faptul că suntem într-un loc
Dialogue: 99,0:00:40.81,0:00:43.40,Dialogue,Akane,0,0,0,,{\i1}unde mă poate convinge să facem sex.
Dialogue: 99,0:00:43.86,0:00:44.65,Dialogue,Nadeshiko,0,0,0,,Hei, Akane?
Dialogue: 99,0:00:45.36,0:00:46.40,Dialogue,Akane,0,0,0,,{\i1}Și începe.
Dialogue: 99,0:00:46.90,0:00:50.03,Dialogue,Akane,0,0,0,,Hei, am o întâlnire foarte \Nlungă în această seară,
Dialogue: 99,0:00:50.03,0:00:53.32,Dialogue,Akane,0,0,0,,așa că trebuie să mă pregătesc, bine?
Dialogue: 99,0:00:54.83,0:00:56.12,Dialogue,Nadeshiko,0,0,0,,Bine.
Dialogue: 99,0:00:56.12,0:00:59.87,Dialogue,Nadeshiko,0,0,0,,Voi trece în modul așteptare \Nca să nu te încurc.
Dialogue: 99,0:01:01.21,0:01:03.79,Dialogue,Akane,0,0,0,,{\i1}Uau, chiar a înțeles.
Dialogue: 99,0:01:05.17,0:01:07.88,Dialogue,Coworker,0,0,0,,Perfect. Ne vedem mâine atunci.
Dialogue: 99,0:01:07.88,0:01:10.47,Dialogue,Akane,0,0,0,,Abia aștept. Ne vedem mâine.
Dialogue: 99,0:01:12.97,0:01:15.56,Dialogue,Akane,0,0,0,,{\i1}Stai, ea chiar nu \Na încercat să facă nimic?
Dialogue: 99,0:01:16.14,0:01:19.14,Dialogue,Akane,0,0,0,,{\i1}Eram sigură că va încerca să-mi facă ceva indecent,
Dialogue: 99,0:01:19.14,0:01:20.89,Dialogue,Akane,0,0,0,,{\i1}dar nu, nimic.
Dialogue: 99,0:01:22.02,0:01:22.65,Dialogue,Nadeshiko,0,0,0,,Akane?
Dialogue: 99,0:01:22.65,0:01:23.52,Dialogue,Akane,0,0,0,,Da?!
Dialogue: 99,0:01:23.77,0:01:25.57,Dialogue,Nadeshiko,0,0,0,,S-a încheiat întâlnirea?
Dialogue: 99,0:01:25.57,0:01:26.57,Dialogue,Akane,0,0,0,,Da.
Dialogue: 99,0:01:26.57,0:01:27.65,Dialogue,Akane,0,0,0,,{\i1}Gata.
Dialogue: 99,0:01:27.94,0:01:29.53,Dialogue,Akane,0,0,0,,{\i1}O să înceapă.
Dialogue: 99,0:01:29.53,0:01:31.78,Dialogue,Nadeshiko,0,0,0,,Atunci ne băgăm la somn?
Dialogue: 99,0:01:31.86,0:01:33.49,Dialogue,Nadeshiko,0,0,0,,Noapte bună.
Dialogue: 99,0:01:35.33,0:01:37.79,Dialogue,Akane,0,0,0,,{\i1}Cum naiba ar trebui să adorm?!
Dialogue: 99,0:01:38.04,0:01:40.29,Dialogue,Akane,0,0,0,,{\i1}Chiar nu are de gând să-mi facă nimic?!
Dialogue: 99,0:01:40.29,0:01:42.71,Dialogue,Akane,0,0,0,,{\i1}Trebuie să mă trezesc devreme mâine, \Ndeci ar trebui să dorm, dar...
Dialogue: 99,0:01:42.71,0:01:44.67,Dialogue,Akane,0,0,0,,{\i1}Liniștește-te.
Dialogue: 99,0:01:45.21,0:01:46.29,Dialogue,Akane,0,0,0,,{\i1}Liniștește-te odată.
Dialogue: 99,0:01:48.50,0:01:50.30,Dialogue,TV,0,0,0,,{\an8}Te vreau acum.
Dialogue: 99,0:01:49.38,0:01:50.30,Dialogue,Akane,0,0,0,,Ce? E de la TV?
Dialogue: 99,0:01:50.59,0:01:52.22,Dialogue,Akane,0,0,0,,Ce ciudat.
Dialogue: 99,0:01:53.22,0:01:55.05,Dialogue,Akane,0,0,0,,De ce nu vrea să se \Noprească prostia asta?
Dialogue: 99,0:01:55.89,0:01:58.81,Dialogue,Nadeshiko,0,0,0,,Acea fată îmi \Namintește de tine, Akane.
Dialogue: 99,0:01:59.97,0:02:00.81,Dialogue,Akane,0,0,0,,Ce? Cum așa?
Dialogue: 99,0:02:02.81,0:02:04.56,Dialogue,Nadeshiko,0,0,0,,Felul cum reacționează \Nîn timpul sexului.
Dialogue: 99,0:02:06.19,0:02:08.52,Dialogue,Nadeshiko,0,0,0,,Hei, Akane?
Dialogue: 99,0:02:10.23,0:02:13.11,Dialogue,Nadeshiko,0,0,0,,Ai vrea să facem și noi ce fac ele?
Dialogue: 99,0:02:14.57,0:02:16.45,Dialogue,TV,0,0,0,,Da, te vreau.
Dialogue: 99,0:02:16.78,0:02:18.03,Dialogue,TV,0,0,0,,Ce vrei, mai exact?
Dialogue: 99,0:02:18.41,0:02:20.58,Dialogue,TV,0,0,0,,Haide, spune-mi.
Dialogue: 99,0:02:20.58,0:02:22.71,Dialogue,TV,0,0,0,,Știi foarte bine. \NNu mă face s-o spun.
Dialogue: 99,0:02:22.71,0:02:24.75,Dialogue,TV,0,0,0,,{\an8}Vreau să te aud cum mă rogi, drăguțo.
Dialogue: 99,0:02:23.08,0:02:24.04,Dialogue,Nadeshiko,0,0,0,,Akane?
Dialogue: 99,0:02:24.71,0:02:25.79,Dialogue,Nadeshiko,0,0,0,,Ce ai dori să fac?
Dialogue: 99,0:02:26.46,0:02:27.21,Dialogue,TV,0,0,0,,Da.
Dialogue: 99,0:02:28.34,0:02:29.92,Dialogue,TV,0,0,0,,Te rog.
Dialogue: 99,0:02:33.97,0:02:36.64,Dialogue,TV,0,0,0,,Fă-mă să am orgasm.
Dialogue: 99,0:02:37.18,0:02:39.01,Dialogue,Akane,0,0,0,,{\i1}Nu o pot spune, dar...
Dialogue: 99,0:02:42.81,0:02:45.65,Dialogue,Nadeshiko,0,0,0,,{\fad(0,350)}Am înțeles. Trec la treabă.
Dialogue: 99,0:02:57.07,0:02:58.16,Dialogue,Akane,0,0,0,,Nadeshiko...
Dialogue: 99,0:03:13.46,0:03:15.59,Dialogue,Akane,0,0,0,,Nadeshiko...
Dialogue: 99,0:03:31.69,0:03:33.90,Dialogue,Nadeshiko,0,0,0,,Îți mulțumesc pentru sfat,
Dialogue: 99,0:03:34.15,0:03:35.57,Dialogue,Nadeshiko,0,0,0,,mamă.
Dialogue: 99,0:03:35.57,0:03:39.66,Dialogue,Sakurako,0,0,0,,Mă bucur că te-am \Nputut ajuta, Nadeshiko.
Dialogue: 99,0:03:39.95,0:03:43.04,Dialogue,Nadeshiko,0,0,0,,M-ai ajutat mult. Apropo,
Dialogue: 99,0:03:43.83,0:03:46.46,Dialogue,Nadeshiko,0,0,0,,de ce mi-ai trimis un mesaj codificat?
Dialogue: 99,0:03:46.46,0:03:50.33,Dialogue,Sakurako,0,0,0,,Ei bine, e puțin prea devreme \Nca să-ți întâlnesc stăpâna.
Dialogue: 99,0:03:50.59,0:03:55.21,Dialogue,Nadeshiko,0,0,0,,Abia aștept să ți-o prezint pe Akane, mamă.
Dialogue: 99,0:03:55.21,0:03:56.84,Dialogue,Sakurako,0,0,0,,Hm... Serios?
Dialogue: 99,0:03:57.76,0:03:58.34,Dialogue,Sakurako,0,0,0,,Bine.
Dialogue: 99,0:03:58.72,0:04:03.56,Dialogue,Sakurako,0,0,0,,Dar doar după ce s-a \Nînregistrat ca stăpâna ta.
Dialogue: 99,0:04:04.39,0:04:05.64,Dialogue,Nadeshiko,0,0,0,,Serios?
Dialogue: 99,0:04:05.64,0:04:08.98,Dialogue,Nadeshiko,0,0,0,,Atunci voi munci din greu \Nca s-o fac stăpâna mea.
