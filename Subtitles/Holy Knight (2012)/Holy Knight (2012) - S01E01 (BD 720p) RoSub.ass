Comment: 0,0:00:00.00,0:00:00.02,Dialogue,chptr,0,0,0,,{Prolog}
Comment: 0,0:04:53.27,0:04:53.31,Dialogue,chptr,0,0,0,,{OP}
Comment: 0,0:07:09.41,0:07:09.45,Dialogue,chptr,0,0,0,,{Episod}
Comment: 0,0:28:43.04,0:28:43.08,Dialogue,chptr,0,0,0,,{ED}
Dialogue: 99,0:00:31.30,0:00:33.10,Dialogue,,0,0,0,,Acesta e cumva...
Dialogue: 99,0:00:33.10,0:00:35.06,Dialogue,,0,0,0,,clopotul de avertizare?
Dialogue: 99,0:00:36.39,0:00:36.89,Dialogue,,0,0,0,,Nu se poate...
Dialogue: 99,0:00:40.40,0:00:41.19,Dialogue,,0,0,0,,Clopotul?
Dialogue: 99,0:01:14.43,0:01:15.31,Dialogue,,0,0,0,,Mami...
Dialogue: 99,0:01:15.31,0:01:17.02,Dialogue,,0,0,0,,Te iubesc, Lilith!
Dialogue: 99,0:01:21.85,0:01:22.85,Dialogue,,0,0,0,,Mami!
Dialogue: 99,0:01:24.02,0:01:26.36,Dialogue,,0,0,0,,Mami!
Dialogue: 99,0:01:27.44,0:01:28.74,Dialogue,,0,0,0,,Poftim, Lilith.
Dialogue: 99,0:01:31.91,0:01:33.57,Dialogue,,0,0,0,,Tati...
Dialogue: 99,0:01:34.87,0:01:38.08,Dialogue,,0,0,0,,Ești o fetiță bună, Lilith. \NSunt foarte mândru de tine.
Dialogue: 99,0:01:38.75,0:01:40.00,Dialogue,,0,0,0,,Așa că ascultă-mă cu atenție.
Dialogue: 99,0:01:40.46,0:01:43.33,Dialogue,,0,0,0,,Eu nu pot veni cu tine deoarece \Ntrebuie să rămân aici ca să te protejez.
Dialogue: 99,0:01:44.38,0:01:46.50,Dialogue,,0,0,0,,Nu vreau să fiu singură! \NVreau să rămân aici cu tine!
Dialogue: 99,0:01:48.71,0:01:51.72,Dialogue,,0,0,0,,Asta nu se poate, Lilith. \NTu trebuie să trăiești.
Dialogue: 99,0:01:55.55,0:01:56.93,Dialogue,,0,0,0,,Hei! I-am găsit!
Dialogue: 99,0:01:57.56,0:01:58.22,Dialogue,,0,0,0,,Fugi, Lilith!
Dialogue: 99,0:02:00.31,0:02:01.81,Dialogue,,0,0,0,,Grăbește-te și \Npleacă de aici! Repede!
Dialogue: 99,0:02:09.78,0:02:11.86,Dialogue,,0,0,0,,I-am găsit pe ultimii.
Dialogue: 99,0:02:11.86,0:02:13.15,Dialogue,,0,0,0,,Omorâți-i pe toți.
Dialogue: 99,0:02:13.15,0:02:14.07,Dialogue,,0,0,0,,Ce?!
Dialogue: 99,0:02:16.41,0:02:18.33,Dialogue,,0,0,0,,Tati!
Dialogue: 99,0:02:19.37,0:02:21.08,Dialogue,,0,0,0,,Aici! Vino repede și urcă!
Dialogue: 99,0:02:22.16,0:02:24.25,Dialogue,,0,0,0,,Lasă-mă pe mine, Lilith!
Dialogue: 99,0:02:24.25,0:02:25.96,Dialogue,,0,0,0,,Nu vreau!
Dialogue: 99,0:02:25.96,0:02:30.51,Dialogue,,0,0,0,,Fii o fetiță bună și \Nascultă de tatăl tău.
Dialogue: 99,0:02:31.55,0:02:32.22,Dialogue,,0,0,0,,Trăiește!
Dialogue: 99,0:02:37.60,0:02:38.76,Dialogue,,0,0,0,,Trebuie să trăiești, Lilith.
Dialogue: 99,0:02:39.76,0:02:41.22,Dialogue,,0,0,0,,De dragul familiei noastre.
Dialogue: 99,0:02:41.22,0:02:46.35,Dialogue,,0,0,0,,{\fad(0,1146)}Tati!
Dialogue: 99,0:02:57.41,0:02:58.28,Dialogue,,0,0,0,,Lilith...
Dialogue: 99,0:02:59.12,0:03:02.16,Dialogue,,0,0,0,,să nu faci aceleași \Ngreșeli ca mama ta.
Dialogue: 99,0:03:03.04,0:03:05.29,Dialogue,,0,0,0,,Ești ultimul strigoi.
Dialogue: 99,0:03:08.42,0:03:09.71,Dialogue,,0,0,0,,Strigoi?
Dialogue: 99,0:03:15.93,0:03:16.63,Dialogue,,0,0,0,,Lilith...
Dialogue: 99,0:03:18.14,0:03:21.93,Dialogue,,0,0,0,,printre trandafiri există un monument \Nde piatră care îți va dezvălui destinul.
Dialogue: 99,0:03:22.64,0:03:24.06,Dialogue,,0,0,0,,Trebuie să-l găsești,
Dialogue: 99,0:03:24.06,0:03:28.02,Dialogue,,0,0,0,,deoarece pe el se află inscripționată \Nlegenda descendenței tale.
Dialogue: 99,0:03:28.86,0:03:30.19,Dialogue,,0,0,0,,Decizia îți va aparține apoi.
Dialogue: 99,0:03:46.96,0:03:49.42,Dialogue,,0,0,0,,Cavalerule Sfânt,
Dialogue: 99,0:03:50.46,0:03:54.21,Dialogue,,0,0,0,,dă naștere copilului din \Ndescendența Romuald.
Dialogue: 99,0:03:54.96,0:03:56.47,Dialogue,,0,0,0,,Copilul...
Dialogue: 99,0:03:58.38,0:03:59.39,Dialogue,,0,0,0,,și tatăl lui...
Dialogue: 99,0:04:03.06,0:04:06.23,Dialogue,,0,0,0,,Fă acest lucru, iar strigoii \Nse vor ridica din nou.
Dialogue: 99,0:07:11.20,0:07:13.87,Dialogue,,0,0,0,,Da, Cliff la telefon.
Dialogue: 99,0:07:13.87,0:07:15.50,Dialogue,,0,0,0,,Infiltrarea a fost un succes.
Dialogue: 99,0:07:16.00,0:07:18.29,Dialogue,,0,0,0,,Exact cum suspectam.
Dialogue: 99,0:07:18.29,0:07:19.84,Dialogue,,0,0,0,,Se află acolo fără îndoială.
Dialogue: 99,0:07:19.84,0:07:21.55,Dialogue,,0,0,0,,Academia Sfântul Ritsumei.
Dialogue: 99,0:07:24.13,0:07:25.63,Dialogue,,0,0,0,,Trebuie să acționați rapid.
Dialogue: 99,0:07:25.63,0:07:27.55,Dialogue,,0,0,0,,Repet: Trebuie să acționați rapid.
Dialogue: 99,0:07:44.07,0:07:47.82,Dialogue,,0,0,0,,La naiba. Alarma de la \Nceas s-a stricat din nou.
Dialogue: 99,0:07:53.29,0:07:55.75,Dialogue,,0,0,0,,Doamne, Shin, iar ai întârziat.
Dialogue: 99,0:07:55.75,0:07:57.96,Dialogue,,0,0,0,,Scuze. Haide să ne grăbim, Chizuru.
Dialogue: 99,0:07:58.71,0:07:59.71,Dialogue,,0,0,0,,Cammot.
Dialogue: 99,0:07:59.71,0:08:02.17,Dialogue,,0,0,0,,Fii cuminte și ai grijă de casă, bine?
Dialogue: 99,0:08:10.64,0:08:12.60,Dialogue,,0,0,0,,Începând de astăzi, \Neu voi fi noua voastră colegă.
Dialogue: 99,0:08:13.14,0:08:14.89,Dialogue,,0,0,0,,Numele meu este Camilla. \NSunt urolog.
Dialogue: 99,0:08:18.39,0:08:19.77,Dialogue,,0,0,0,,Mă bucur să vă cunosc.
Dialogue: 99,0:08:20.48,0:08:21.73,Dialogue,,0,0,0,,Lordul meu,
Dialogue: 99,0:08:22.48,0:08:25.49,Dialogue,,0,0,0,,e timpul să plecăm spre Crimeea.
Dialogue: 99,0:08:27.95,0:08:29.20,Dialogue,,0,0,0,,Lordul meu.
Dialogue: 99,0:08:32.74,0:08:35.37,Dialogue,,0,0,0,,Așteaptă-mă, Shin!
Dialogue: 99,0:08:38.71,0:08:41.21,Dialogue,,0,0,0,,Nimic nu se compară cu \Nalergatul de dimineață.
Dialogue: 99,0:09:03.06,0:09:03.77,Dialogue,,0,0,0,,Kishimoto.
Dialogue: 99,0:09:05.02,0:09:06.23,Dialogue,,0,0,0,,Kishimoto Lilith.
Dialogue: 99,0:09:08.53,0:09:09.45,Dialogue,,0,0,0,,Lilith?
Dialogue: 99,0:09:11.03,0:09:13.53,Dialogue,,0,0,0,,Scuze. Eu sunt Mizumura Shinta.
Dialogue: 99,0:09:14.53,0:09:17.58,Dialogue,,0,0,0,,Te îndrepți spre academie?
Dialogue: 99,0:09:19.41,0:09:21.92,Dialogue,,0,0,0,,Deoarece așa părea.
Dialogue: 99,0:09:21.92,0:09:23.63,Dialogue,,0,0,0,,Am venit aici ca să te întâlnesc.
Dialogue: 99,0:09:23.63,0:09:26.75,Dialogue,,0,0,0,,Poftim? Ce ai spus?
Dialogue: 99,0:09:26.75,0:09:30.01,Dialogue,,0,0,0,,Destinele noastre sunt conectate.
Dialogue: 99,0:09:31.55,0:09:32.59,Dialogue,,0,0,0,,{\i1}Mâinile ei sunt reci.
Dialogue: 99,0:09:33.39,0:09:36.06,Dialogue,,0,0,0,,Așa moale și delicios.
Dialogue: 99,0:09:37.35,0:09:37.93,Dialogue,,0,0,0,,Poftim?
Dialogue: 99,0:09:44.02,0:09:47.69,Dialogue,,0,0,0,,Doamne, Shin, cât vei mai \Nvisa cu ochii deschiși?
Dialogue: 99,0:09:47.69,0:09:48.40,Dialogue,,0,0,0,,Hei!
Dialogue: 99,0:09:48.40,0:09:50.57,Dialogue,,0,0,0,,Doamne, ce e în neregulă cu tine?
Dialogue: 99,0:09:59.08,0:10:01.66,Dialogue,,0,0,0,,{\i1}Ce a fost chestia de mai devreme?
Dialogue: 99,0:10:04.71,0:10:07.84,Dialogue,,0,0,0,,{\i1}Shin s-a holbat toată \Nziua la noua colegă.
Dialogue: 99,0:10:08.67,0:10:09.80,Dialogue,,0,0,0,,{\i1}Și nu numai el.
Dialogue: 99,0:10:09.80,0:10:12.63,Dialogue,,0,0,0,,{\i1}Amândoi își aruncau priviri unul altuia.
Dialogue: 99,0:10:13.09,0:10:15.47,Dialogue,,0,0,0,,{\i1}Doamne, chiar nu se poate \Nopri din a se holba la ea.
Dialogue: 99,0:10:16.35,0:10:19.60,Dialogue,,0,0,0,,{\i1}Când voi deveni o scriitoare,
Dialogue: 99,0:10:19.60,0:10:22.44,Dialogue,,0,0,0,,{\i1}Shin va avea ochi \Nnumai pentru mine!
Dialogue: 99,0:10:23.98,0:10:25.40,Dialogue,,0,0,0,,Ce?
Dialogue: 99,0:10:25.40,0:10:27.82,Dialogue,,0,0,0,,Mă întreb unde s-a dus Shin.
Dialogue: 99,0:10:27.82,0:10:30.86,Dialogue,,0,0,0,,Voiam să-l întreb dacă vrea să luăm prânzul împreună.
Dialogue: 99,0:10:33.45,0:10:36.07,Dialogue,,0,0,0,,La naiba! Adică... ești bine?
Dialogue: 99,0:10:36.07,0:10:37.83,Dialogue,,0,0,0,,Dle profesor Cliff.
Dialogue: 99,0:10:37.83,0:10:39.08,Dialogue,,0,0,0,,Îmi cer scuze.
Dialogue: 99,0:10:39.08,0:10:41.50,Dialogue,,0,0,0,,Mă bucur că nu ai pățit nimic.
Dialogue: 99,0:10:41.50,0:10:43.79,Dialogue,,0,0,0,,Iubitul tău te-a lăsat în urmă?
Dialogue: 99,0:10:43.79,0:10:45.00,Dialogue,,0,0,0,,Iubit?
Dialogue: 99,0:10:46.21,0:10:49.55,Dialogue,,0,0,0,,Ești cea mai bună elevă de la \Nora mea de Istorie a Folclorului.
Dialogue: 99,0:10:50.30,0:10:52.76,Dialogue,,0,0,0,,E în regulă să fii îndrăgostită, \Ndar să nu uiți de raport, bine?
Dialogue: 99,0:10:55.64,0:10:59.31,Dialogue,,0,0,0,,{\i1}Dle profesor Cliff \Na venit săptămâna trecută,
Dialogue: 99,0:10:59.97,0:11:02.02,Dialogue,,0,0,0,,{\i1}dar s-a adaptat deja.
Dialogue: 99,0:11:02.02,0:11:04.56,Dialogue,,0,0,0,,{\i1}Orele sale despre Istoria \NFolclorului sunt interesante.
Dialogue: 99,0:11:04.56,0:11:06.98,Dialogue,,0,0,0,,{\i1}Uneori folosește cuvinte ciudate,
Dialogue: 99,0:11:06.98,0:11:08.65,Dialogue,,0,0,0,,{\i1}dar rămâne grozav,
Dialogue: 99,0:11:08.65,0:11:10.07,Dialogue,,0,0,0,,{\i1}deși e destul de în vârstă.
Dialogue: 99,0:11:10.07,0:11:13.57,Dialogue,,0,0,0,,Oh, da, am uitat complet \Ncă-l căutam pe Shin.
Dialogue: 99,0:11:15.53,0:11:17.99,Dialogue,,0,0,0,,Ei bine... Despre ce voiai să vorbim?
Dialogue: 99,0:11:17.99,0:11:19.62,Dialogue,,0,0,0,,S-a întâmplat ceva?
Dialogue: 99,0:11:19.62,0:11:24.16,Dialogue,,0,0,0,,E primul meu an aici, deci nu prea știu \Nmulte lucruri despre această academie.
Dialogue: 99,0:11:24.16,0:11:26.75,Dialogue,,0,0,0,,Dar în legătură cu ce s-a \Nîntâmplat în această dimineață...
Dialogue: 99,0:11:27.71,0:11:30.75,Dialogue,,0,0,0,,De acum înainte, \Nnoi doi vom face sex.
Dialogue: 99,0:11:32.09,0:11:34.38,Dialogue,,0,0,0,,Vreau să-ți port copilul în pântece.
Dialogue: 99,0:11:35.38,0:11:38.51,Dialogue,,0,0,0,,Ce tot spui acolo, Kishimoto?
Dialogue: 99,0:11:39.10,0:11:40.10,Dialogue,,0,0,0,,{\i1}Mâinile ei sunt așa de reci.
Dialogue: 99,0:11:40.85,0:11:44.48,Dialogue,,0,0,0,,Nu știu cum funcționează \Nlucrurile în țara ta,
Dialogue: 99,0:11:44.48,0:11:50.32,Dialogue,,0,0,0,,dar aici doar persoanele care \Nse iubesc fac acel gen de lucruri.
Dialogue: 99,0:11:50.32,0:11:52.15,Dialogue,,0,0,0,,Persoanele care se iubesc?
Dialogue: 99,0:11:52.15,0:11:56.82,Dialogue,,0,0,0,,Da, un copil apare din \Niubirea a două persoane.
Dialogue: 99,0:11:57.28,0:11:59.45,Dialogue,,0,0,0,,Sau cel puțin asta am \Nauzit de la bunicul meu.
Dialogue: 99,0:11:59.45,0:12:00.33,Dialogue,,0,0,0,,De asta...
Dialogue: 99,0:12:00.74,0:12:02.70,Dialogue,,0,0,0,,Iubirea e așa o bătaie de cap.
Dialogue: 99,0:12:02.70,0:12:04.54,Dialogue,,0,0,0,,Descendența Romuald...
Dialogue: 99,0:12:06.21,0:12:09.33,Dialogue,,0,0,0,,Gata cu scuzele! \NHaide să facem sex!
Dialogue: 99,0:12:10.29,0:12:12.17,Dialogue,,0,0,0,,Stai puțin, Kishimoto!
Dialogue: 99,0:12:12.96,0:12:15.59,Dialogue,,0,0,0,,Nu am niciun pic de experiență \Ncu astfel de lucruri.
Dialogue: 99,0:12:15.59,0:12:17.55,Dialogue,,0,0,0,,Păi... De asta... Ei bine...
Dialogue: 99,0:12:18.22,0:12:19.80,Dialogue,,0,0,0,,De asta... Stai... \NAșteaptă, te rog!
Dialogue: 99,0:12:22.06,0:12:24.81,Dialogue,,0,0,0,,Nu mai înțeleg nimic!
Dialogue: 99,0:12:25.18,0:12:29.44,Dialogue,,0,0,0,,Kishimoto, nu putem \Ngrăbi lucrurile astfel.
Dialogue: 99,0:12:29.44,0:12:30.65,Dialogue,,0,0,0,,Îmi cer scuze!
Dialogue: 99,0:12:34.98,0:12:36.40,Dialogue,,0,0,0,,Chizuru.
Dialogue: 99,0:12:36.40,0:12:38.53,Dialogue,,0,0,0,,Shin, deci aici erai.
Dialogue: 99,0:12:41.91,0:12:43.83,Dialogue,,0,0,0,,Ei bine, vezi tu...
Dialogue: 99,0:12:45.25,0:12:47.21,Dialogue,,0,0,0,,Nu e ceea ce pare.
Dialogue: 99,0:12:47.21,0:12:47.71,Dialogue,,0,0,0,,Nu-i așa?
Dialogue: 99,0:12:48.54,0:12:49.83,Dialogue,,0,0,0,,Ești așa de inutil.
Dialogue: 99,0:12:59.97,0:13:00.89,Dialogue,,0,0,0,,Kishimoto!
Dialogue: 99,0:13:01.26,0:13:02.85,Dialogue,,0,0,0,,Ce a fost asta, Shin?
Dialogue: 99,0:13:02.85,0:13:05.68,Dialogue,,0,0,0,,După cum am spus, \Nnu e ceea ce pare.
Dialogue: 99,0:13:05.68,0:13:07.27,Dialogue,,0,0,0,,Nici măcar eu nu știu ce a fost.
Dialogue: 99,0:13:24.41,0:13:28.66,Dialogue,,0,0,0,,„Un copil apare din \Niubirea a două persoane.”
Dialogue: 99,0:13:30.75,0:13:33.21,Dialogue,,0,0,0,,De ce trebuie s-o fac cu el?
Dialogue: 99,0:13:37.59,0:13:38.67,Dialogue,,0,0,0,,Încetează.
Dialogue: 99,0:13:39.55,0:13:42.76,Dialogue,,0,0,0,,Am lătrat precum un câine, \Ndeși eu sunt lup, nu?
Dialogue: 99,0:13:43.39,0:13:46.14,Dialogue,,0,0,0,,Și ce-ai să obții prin asta?
Dialogue: 99,0:13:46.14,0:13:47.22,Dialogue,,0,0,0,,Ai dreptate.
Dialogue: 99,0:13:47.22,0:13:50.02,Dialogue,,0,0,0,,Nu te enerva așa.
Dialogue: 99,0:13:50.02,0:13:52.19,Dialogue,,0,0,0,,Trebuie să te înveselești, Lilith.
Dialogue: 99,0:13:53.02,0:13:56.19,Dialogue,,0,0,0,,De ce se comportă astfel când \Ndestinele noastre sunt conectate?
Dialogue: 99,0:13:57.48,0:14:01.03,Dialogue,,0,0,0,,Dacă vei fi așa de agresivă, \Ndoar îl vei speria.
Dialogue: 99,0:14:01.03,0:14:02.86,Dialogue,,0,0,0,,Pariez că e virgin.
Dialogue: 99,0:14:03.32,0:14:04.53,Dialogue,,0,0,0,,Ce ar trebui să fac?
Dialogue: 99,0:14:06.03,0:14:08.83,Dialogue,,0,0,0,,Ar trebui să fii mai blândă.
Dialogue: 99,0:14:08.83,0:14:10.25,Dialogue,,0,0,0,,De ce nu începi cu un zâmbet?
Dialogue: 99,0:14:10.71,0:14:11.50,Dialogue,,0,0,0,,Zâmbet?
Dialogue: 99,0:14:12.62,0:14:14.13,Dialogue,,0,0,0,,Blândețe. Iubire.
Dialogue: 99,0:14:15.59,0:14:16.46,Dialogue,,0,0,0,,Nu prea înțeleg.
Dialogue: 99,0:14:18.34,0:14:21.30,Dialogue,,0,0,0,,Trebuie să mă grăbesc și să duc la bun sfârșit ceea ce a fost scris.
Dialogue: 99,0:14:25.47,0:14:26.85,Dialogue,,0,0,0,,Blândețe...
Dialogue: 99,0:14:27.97,0:14:29.72,Dialogue,,0,0,0,,Nu cred că ar trebui să te grăbești.
Dialogue: 99,0:14:30.27,0:14:33.19,Dialogue,,0,0,0,,Oricum, nu ar trebui să subestimezi \Nlumina solară din Japonia.
Dialogue: 99,0:14:33.19,0:14:36.56,Dialogue,,0,0,0,,Ar putea fi periculos dacă \Nvei sta prea mult în ea.
Dialogue: 99,0:14:36.56,0:14:37.98,Dialogue,,0,0,0,,{\i1}Descendența Romuald...
Dialogue: 99,0:14:39.23,0:14:42.74,Dialogue,,0,0,0,,{\i1}Asta e tot ce am nevoie...
Dialogue: 99,0:14:43.91,0:14:45.32,Dialogue,,0,0,0,,Bun, continuați!
Dialogue: 99,0:14:45.91,0:14:48.54,Dialogue,,0,0,0,,E timpul să lucrăm pieptul!
Dialogue: 99,0:14:48.54,0:14:49.79,Dialogue,,0,0,0,,Priviți cu atenție!
Dialogue: 99,0:14:49.79,0:14:51.66,Dialogue,,0,0,0,,Unu, doi. Unu, doi!
Dialogue: 99,0:14:51.66,0:14:54.17,Dialogue,,0,0,0,,Unu, doi. Unu, doi!
Dialogue: 99,0:14:54.17,0:14:55.33,Dialogue,,0,0,0,,E un prost!
Dialogue: 99,0:14:55.33,0:14:56.38,Dialogue,,0,0,0,,E cel mai mare prost!
Dialogue: 99,0:14:56.38,0:14:58.55,Dialogue,,0,0,0,,Nu e adevărat! \NNu e adevărat!
Dialogue: 99,0:14:59.55,0:15:04.01,Dialogue,,0,0,0,,Dar nu l-am mai văzut pe Shin să se \Nuite în acel mod la o altă persoană.
Dialogue: 99,0:15:05.72,0:15:08.47,Dialogue,,0,0,0,,Shin!
Dialogue: 99,0:15:10.31,0:15:11.81,Dialogue,,0,0,0,,{\fad(200,0)}Am fost luat prin surprindere.
Dialogue: 99,0:15:11.81,0:15:13.64,Dialogue,,0,0,0,,Da, a fost foarte brusc.
Dialogue: 99,0:15:14.19,0:15:18.31,Dialogue,,0,0,0,,Devine periculos. Trebuie să punem mâna pe ultimul supraviețuitor, cu orice preț.
Dialogue: 99,0:15:18.86,0:15:21.11,Dialogue,,0,0,0,,Da, înțeleg.
Dialogue: 99,0:15:21.11,0:15:23.24,Dialogue,,0,0,0,,De asta am venit aici.
Dialogue: 99,0:15:24.15,0:15:25.28,Dialogue,,0,0,0,,Recepționat.
Dialogue: 99,0:15:26.36,0:15:29.99,Dialogue,,0,0,0,,Vom veghea asupra descendentului.
Dialogue: 99,0:15:30.91,0:15:33.16,Dialogue,,0,0,0,,Shin, iar ai dormit prea mult.
Dialogue: 99,0:15:33.16,0:15:34.33,Dialogue,,0,0,0,,Scuze.
Dialogue: 99,0:15:35.04,0:15:37.42,Dialogue,,0,0,0,,Cammot, am plecat.
Dialogue: 99,0:15:37.83,0:15:39.88,Dialogue,,0,0,0,,Fii cuminte și ai grijă de casă.
Dialogue: 99,0:15:40.46,0:15:42.05,Dialogue,,0,0,0,,Să mergem, Chizuru.
Dialogue: 99,0:15:42.05,0:15:43.21,Dialogue,,0,0,0,,Shinta.
Dialogue: 99,0:15:44.34,0:15:46.38,Dialogue,,0,0,0,,Vom merge împreună spre academie.
Dialogue: 99,0:15:47.43,0:15:49.39,Dialogue,,0,0,0,,Kishimoto, de ce ești aici?
Dialogue: 99,0:15:49.76,0:15:53.81,Dialogue,,0,0,0,,Deoarece destinele \Nnoastre sunt conectate.
Dialogue: 99,0:16:04.86,0:16:07.82,Dialogue,,0,0,0,,Ești așa un băiat bun, Shinta.
Dialogue: 99,0:16:07.82,0:16:09.41,Dialogue,,0,0,0,,Fii blând cu mine.
Dialogue: 99,0:16:09.41,0:16:10.99,Dialogue,,0,0,0,,Bine.
Dialogue: 99,0:16:13.33,0:16:14.04,Dialogue,,0,0,0,,Să mergem.
Dialogue: 99,0:16:24.34,0:16:25.22,Dialogue,,0,0,0,,La o parte din drum.
Dialogue: 99,0:16:26.01,0:16:27.01,Dialogue,,0,0,0,,Chizuru.
Dialogue: 99,0:16:30.39,0:16:31.89,Dialogue,,0,0,0,,Shin!
Dialogue: 99,0:16:32.97,0:16:34.18,Dialogue,,0,0,0,,Hei, Kishimoto!
Dialogue: 99,0:16:34.18,0:16:35.31,Dialogue,,0,0,0,,Așteaptă puțin!
Dialogue: 99,0:16:35.60,0:16:37.94,Dialogue,,0,0,0,,Nu voi aștepta. Mă grăbesc.
Dialogue: 99,0:16:38.81,0:16:41.77,Dialogue,,0,0,0,,Fii băiat bun și ascultă ce-ți spun.
Dialogue: 99,0:16:42.32,0:16:42.86,Dialogue,,0,0,0,,Dar...
Dialogue: 99,0:16:48.95,0:16:49.57,Dialogue,,0,0,0,,Kishimoto?
Dialogue: 99,0:16:50.62,0:16:52.45,Dialogue,,0,0,0,,Kishimoto, ce s-a întâmplat?
Dialogue: 99,0:16:53.45,0:16:54.70,Dialogue,,0,0,0,,Ești bine?
Dialogue: 99,0:16:54.70,0:16:55.45,Dialogue,,0,0,0,,Kishimoto!
Dialogue: 99,0:17:05.05,0:17:07.09,Dialogue,,0,0,0,,Păi... Ei bine...
Dialogue: 99,0:17:07.84,0:17:09.88,Dialogue,,0,0,0,,Ce ar trebui să fac acum?
Dialogue: 99,0:17:11.93,0:17:12.60,Dialogue,,0,0,0,,Kishimoto?
Dialogue: 99,0:17:13.85,0:17:14.89,Dialogue,,0,0,0,,Tată...
Dialogue: 99,0:17:19.02,0:17:20.44,Dialogue,,0,0,0,,Mâinile ei sunt așa de reci.
Dialogue: 99,0:17:22.36,0:17:24.65,Dialogue,,0,0,0,,Nu... Împreună...
Dialogue: 99,0:17:27.07,0:17:28.99,Dialogue,,0,0,0,,Haide să plecăm împreună.
Dialogue: 99,0:17:32.87,0:17:34.20,Dialogue,,0,0,0,,Tată.
Dialogue: 99,0:17:35.95,0:17:37.37,Dialogue,,0,0,0,,Kishimoto, rezistă.
Dialogue: 99,0:17:41.04,0:17:43.59,Dialogue,,0,0,0,,Ce este, Lilith? Ți-e foame?
Dialogue: 99,0:17:44.29,0:17:48.67,Dialogue,,0,0,0,,Asta e o problemă. Mămica ta \Nnu se va întoarce pentru o vreme.
Dialogue: 99,0:17:49.92,0:17:51.43,Dialogue,,0,0,0,,Gata, gata.
Dialogue: 99,0:17:51.43,0:17:53.89,Dialogue,,0,0,0,,Tăticul tău îți va pregăti ceva...
Dialogue: 99,0:17:53.89,0:17:55.26,Dialogue,,0,0,0,,Bine?
Dialogue: 99,0:17:57.06,0:17:58.18,Dialogue,,0,0,0,,Tată...
Dialogue: 99,0:18:07.94,0:18:09.78,Dialogue,,0,0,0,,Scuze. Părea că te doare ceva,
Dialogue: 99,0:18:10.11,0:18:11.53,Dialogue,,0,0,0,,deci m-am gândit că asta te-ar ajuta.
Dialogue: 99,0:18:13.45,0:18:14.62,Dialogue,,0,0,0,,Serios?
Dialogue: 99,0:18:16.03,0:18:19.66,Dialogue,,0,0,0,,Ai leșinat dintr-odată, \Ndeci am încercat să te ajut.
Dialogue: 99,0:18:22.00,0:18:25.17,Dialogue,,0,0,0,,Dar mai important, \Nar trebui să mănânci ceva.
Dialogue: 99,0:18:26.00,0:18:28.84,Dialogue,,0,0,0,,Hm... Asta s-ar putea \Nsă fie o problemă.
Dialogue: 99,0:18:28.84,0:18:30.38,Dialogue,,0,0,0,,Nu am nimic aici.
Dialogue: 99,0:18:32.26,0:18:34.14,Dialogue,,0,0,0,,Am reușit să găsesc \Ndoar ramen instant.
Dialogue: 99,0:18:34.14,0:18:35.93,Dialogue,,0,0,0,,Ți-ar plăcea să merg \Nși să cumpăr altceva?
Dialogue: 99,0:18:36.60,0:18:37.56,Dialogue,,0,0,0,,E în regulă.
Dialogue: 99,0:18:39.31,0:18:40.73,Dialogue,,0,0,0,,Ești sigură?
Dialogue: 99,0:18:42.19,0:18:44.23,Dialogue,,0,0,0,,Presupun că da.
Dialogue: 99,0:18:44.23,0:18:45.73,Dialogue,,0,0,0,,Ei bine...
Dialogue: 99,0:18:46.56,0:18:48.19,Dialogue,,0,0,0,,Sunt puțin cam...
Dialogue: 99,0:18:52.20,0:18:54.16,Dialogue,,0,0,0,,{\i1}Tocmai mi-am imaginat asta?
Dialogue: 99,0:18:54.95,0:18:56.62,Dialogue,,0,0,0,,Ar trebui să fie bine așa.
Dialogue: 99,0:18:59.74,0:19:01.33,Dialogue,,0,0,0,,Mai durează puțin, Lilith.
Dialogue: 99,0:19:02.33,0:19:06.88,Dialogue,,0,0,0,,Tăticul tău îți pregătește \No tocăniță delicioasă.
Dialogue: 99,0:19:08.38,0:19:11.63,Dialogue,,0,0,0,,{\i1}Nu. Nu e posibil așa ceva.
Dialogue: 99,0:19:12.72,0:19:15.39,Dialogue,,0,0,0,,Scuze. Asta e tot ce am putut pregăti.
Dialogue: 99,0:19:29.27,0:19:30.23,Dialogue,,0,0,0,,E oribil.
Dialogue: 99,0:19:30.23,0:19:31.78,Dialogue,,0,0,0,,Oribil?
Dialogue: 99,0:19:31.78,0:19:33.24,Dialogue,,0,0,0,,Serios?
Dialogue: 99,0:19:34.07,0:19:35.45,Dialogue,,0,0,0,,De obicei, e destul de bun.
Dialogue: 99,0:19:53.34,0:19:54.30,Dialogue,,0,0,0,,Tot e oribil.
Dialogue: 99,0:19:54.80,0:19:55.97,Dialogue,,0,0,0,,Serios?
Dialogue: 99,0:19:55.97,0:19:57.84,Dialogue,,0,0,0,,E mâncarea mea favorită.
Dialogue: 99,0:19:57.84,0:19:59.43,Dialogue,,0,0,0,,Chiar e așa de rea?
Dialogue: 99,0:20:06.64,0:20:08.69,Dialogue,,0,0,0,,Vâsliți, vâsliți!
Dialogue: 99,0:20:08.69,0:20:11.82,Dialogue,,0,0,0,,Haideți! Să lucrăm pieptul.
Dialogue: 99,0:20:11.82,0:20:16.24,Dialogue,,0,0,0,,Vâsliți de parcă \Ndestinația e iubirea voastră!
Dialogue: 99,0:20:17.36,0:20:19.20,Dialogue,,0,0,0,,Vâsliți, vâsliți!
Dialogue: 99,0:20:19.20,0:20:21.78,Dialogue,,0,0,0,,Care-i problema acelei tipe?
Dialogue: 99,0:20:24.62,0:20:25.96,Dialogue,,0,0,0,,Chiar mă enervează!
Dialogue: 99,0:20:25.96,0:20:29.92,Dialogue,,0,0,0,,Nu voi pierde în fața ei!
Dialogue: 99,0:20:30.79,0:20:33.67,Dialogue,,0,0,0,,Shin e al meu. Nu voi \Nlăsa pe nimeni să-l aibă!
Dialogue: 99,0:20:40.22,0:20:43.81,Dialogue,,0,0,0,,În sfârșit, mi-am găsit zeița!
Dialogue: 99,0:20:44.31,0:20:46.02,Dialogue,,0,0,0,,Chiar e distractiv să faci poze?
Dialogue: 99,0:20:48.98,0:20:49.60,Dialogue,,0,0,0,,Așa?
Dialogue: 99,0:20:49.77,0:20:51.36,Dialogue,,0,0,0,,Dar asta cum e?
Dialogue: 99,0:20:55.32,0:20:56.78,Dialogue,,0,0,0,,Poți sta așa?
Dialogue: 99,0:20:57.24,0:20:59.07,Dialogue,,0,0,0,,Nicio problemă!
Dialogue: 99,0:20:59.41,0:21:00.91,Dialogue,,0,0,0,,Zeița mea!
Dialogue: 99,0:21:01.28,0:21:02.74,Dialogue,,0,0,0,,Oh, am uitat.
Dialogue: 99,0:21:02.74,0:21:04.58,Dialogue,,0,0,0,,Trebuie să scriu ceva \Ndespre Shinta și astăzi.
Dialogue: 99,0:21:05.54,0:21:09.37,Dialogue,,0,0,0,,Astăzi e o altă zi fără speranță...
Dialogue: 99,0:21:11.17,0:21:13.25,Dialogue,,0,0,0,,Așa de drăguță!
Dialogue: 99,0:21:13.71,0:21:17.09,Dialogue,,0,0,0,,Și Shinta este fără speranță.
Dialogue: 99,0:21:17.51,0:21:22.51,Dialogue,,0,0,0,,Deci trebuie să-l protejez pe Shinta.
Dialogue: 99,0:21:23.14,0:21:25.22,Dialogue,,0,0,0,,Nicio problemă.
Dialogue: 99,0:21:35.82,0:21:37.44,Dialogue,,0,0,0,,Hei, Lilith.
Dialogue: 99,0:21:37.82,0:21:42.91,Dialogue,,0,0,0,,Nu te încurcă fata care e \Nmereu lângă băiatul Romuald?
Dialogue: 99,0:21:45.29,0:21:46.95,Dialogue,,0,0,0,,Hei, hei, Lilith.
Dialogue: 99,0:21:46.95,0:21:49.12,Dialogue,,0,0,0,,Hei, hei, hei, Lilith, hei, hei.
Dialogue: 99,0:21:49.12,0:21:51.21,Dialogue,,0,0,0,,Lilith, hei, hei, hei, Lilith, hei, hei.
Dialogue: 99,0:21:51.21,0:21:51.75,Dialogue,,0,0,0,,Mai taci!
Dialogue: 99,0:21:53.84,0:21:55.42,Dialogue,,0,0,0,,Ți-am spus să încetezi!
Dialogue: 99,0:22:04.51,0:22:05.89,Dialogue,,0,0,0,,Ce e acest sentiment?
Dialogue: 99,0:22:09.23,0:22:10.64,Dialogue,,0,0,0,,{\i1}Mâinile sale...
Dialogue: 99,0:22:10.64,0:22:12.19,Dialogue,,0,0,0,,{\i1}...erau calde.
Dialogue: 99,0:22:15.19,0:22:15.98,Dialogue,,0,0,0,,{\i1}Nu.
Dialogue: 99,0:22:16.82,0:22:18.11,Dialogue,,0,0,0,,{\i1}Nu seamănă cu tata.
Dialogue: 99,0:22:21.20,0:22:22.45,Dialogue,,0,0,0,,{\i1}Am o misiune.
Dialogue: 99,0:22:23.82,0:22:25.16,Dialogue,,0,0,0,,{\i1}Și trebuie s-o duc la bun sfârșit!
Dialogue: 99,0:22:35.59,0:22:40.80,Dialogue,,0,0,0,,{\i1}Trebuie să dau naștere unui \Ncopil din descendența Romuald.
Dialogue: 99,0:22:41.38,0:22:45.26,Dialogue,,0,0,0,,{\i1}Apoi, să-l omor și pe el, și pe Mizumura \NShinta și să mă scald în sângele lor.
Dialogue: 99,0:22:46.30,0:22:48.43,Dialogue,,0,0,0,,Acesta este destinul meu!
Dialogue: 99,0:23:00.65,0:23:08.66,Dialogue,,0,0,0,,{\an8\i1}Numărul apelat nu poate fi contactat. \NVă rugăm să încercați mai târziu.
Dialogue: 99,0:23:07.12,0:23:08.37,Dialogue,,0,0,0,,Shin...
Dialogue: 99,0:23:09.16,0:23:09.99,Dialogue,,0,0,0,,Ce tot faci?
Dialogue: 99,0:23:09.99,0:23:12.71,Dialogue,,0,0,0,,{\an8\i1}Numărul apelat nu poate fi contactat.
Dialogue: 99,0:23:11.33,0:23:12.71,Dialogue,,0,0,0,,Sakamoto?
Dialogue: 99,0:23:13.37,0:23:14.42,Dialogue,,0,0,0,,De cât timp ești aici?
Dialogue: 99,0:23:15.29,0:23:18.55,Dialogue,,0,0,0,,Nu prea ies în evidență.
Dialogue: 99,0:23:18.55,0:23:20.80,Dialogue,,0,0,0,,N-Nu, asta nu e adevărat.
Dialogue: 99,0:23:21.59,0:23:24.43,Dialogue,,0,0,0,,Eram doar pierdută în gânduri.
Dialogue: 99,0:23:25.05,0:23:26.72,Dialogue,,0,0,0,,Te gândeai la Mizumura Shinta?
Dialogue: 99,0:23:27.60,0:23:30.18,Dialogue,,0,0,0,,Cum ți-ai dat seama... adică, nu...
Dialogue: 99,0:23:32.48,0:23:34.10,Dialogue,,0,0,0,,Va fi luat de lângă tine.
Dialogue: 99,0:23:35.02,0:23:36.15,Dialogue,,0,0,0,,Ești în regulă cu asta?
Dialogue: 99,0:23:37.19,0:23:37.98,Dialogue,,0,0,0,,Nu, nu sunt!
Dialogue: 99,0:23:37.98,0:23:40.23,Dialogue,,0,0,0,,Nu voi lăsa asta să se întâmple!
Dialogue: 99,0:23:40.78,0:23:41.65,Dialogue,,0,0,0,,Unde te duci?
Dialogue: 99,0:23:41.65,0:23:43.07,Dialogue,,0,0,0,,Acasă la Shin!
Dialogue: 99,0:23:46.70,0:23:50.62,Dialogue,,0,0,0,,Lilith, nu ar trebui să \Nchiulești de la școală.
Dialogue: 99,0:23:50.62,0:23:54.62,Dialogue,,0,0,0,,Nu simt că-mi fac treaba așa.
Dialogue: 99,0:23:57.13,0:23:57.88,Dialogue,,0,0,0,,Aceea era...
Dialogue: 99,0:23:59.84,0:24:04.47,Dialogue,,0,0,0,,Ia te uită, are un fund drăguț \Nși niște sâni frumoși.
Dialogue: 99,0:24:05.01,0:24:07.72,Dialogue,,0,0,0,,E imposibil ca Lilith s-o învingă.
Dialogue: 99,0:24:08.22,0:24:12.18,Dialogue,,0,0,0,,În regulă, voi revendica eu acei \Nsâni pentru binele lui Lilith.
Dialogue: 99,0:24:20.90,0:24:21.69,Dialogue,,0,0,0,,{\i1}Shin.
Dialogue: 99,0:24:23.40,0:24:26.11,Dialogue,,0,0,0,,{\i1}Nu voi lăsa pe nimeni \Nsă-l aibă pe Shin.
Dialogue: 99,0:24:27.36,0:24:28.82,Dialogue,,0,0,0,,Ce ți se mai bălăngăne sânii.
Dialogue: 99,0:24:31.91,0:24:33.54,Dialogue,,0,0,0,,Cine a spus asta?
Dialogue: 99,0:24:36.46,0:24:39.54,Dialogue,,0,0,0,,Exact cum credeam, \Nai sânii mai mari decât Lilith.
Dialogue: 99,0:24:42.96,0:24:44.38,Dialogue,,0,0,0,,Poftim?
Dialogue: 99,0:24:46.92,0:24:48.59,Dialogue,,0,0,0,,Auci...
Dialogue: 99,0:24:51.85,0:24:53.06,Dialogue,,0,0,0,,Ce avem noi aici?
Dialogue: 99,0:24:53.06,0:24:56.85,Dialogue,,0,0,0,,Ești cumva virgină? \NSimt mirosul unei fete virgine.
Dialogue: 99,0:24:59.15,0:25:00.02,Dialogue,,0,0,0,,Cine...
Dialogue: 99,0:25:01.19,0:25:02.23,Dialogue,,0,0,0,,...naiba ești?!
Dialogue: 99,0:25:02.69,0:25:03.27,Dialogue,,0,0,0,,Hei,
Dialogue: 99,0:25:03.94,0:25:06.07,Dialogue,,0,0,0,,ce ai zice să uiți de acel tip?
Dialogue: 99,0:25:06.40,0:25:09.36,Dialogue,,0,0,0,,Dacă o vei face, noi doi am \Nputea deveni mai apropiați, știi?
Dialogue: 99,0:25:11.78,0:25:12.53,Dialogue,,0,0,0,,Ce?
Dialogue: 99,0:25:23.25,0:25:24.80,Dialogue,,0,0,0,,{\i1}Ce se întâmplă?
Dialogue: 99,0:25:24.80,0:25:25.84,Dialogue,,0,0,0,,{\i1}Ce-mi face?
Dialogue: 99,0:25:26.51,0:25:27.59,Dialogue,,0,0,0,,Nu!
Dialogue: 99,0:25:28.38,0:25:30.89,Dialogue,,0,0,0,,Nu te enerva, sâni frumoși.
Dialogue: 99,0:25:31.26,0:25:34.35,Dialogue,,0,0,0,,Îți mulțumesc pentru onoarea \Nde a gusta niște buze virgine.
Dialogue: 99,0:25:34.76,0:25:36.39,Dialogue,,0,0,0,,Ți-am furat primul sărut, nu-i așa?
Dialogue: 99,0:25:37.81,0:25:38.81,Dialogue,,0,0,0,,Nu-i așa?
Dialogue: 99,0:25:39.52,0:25:40.14,Dialogue,,0,0,0,,Nu!
Dialogue: 99,0:25:45.90,0:25:47.86,Dialogue,,0,0,0,,Misiune îndeplinită.
Dialogue: 99,0:25:47.86,0:25:50.45,Dialogue,,0,0,0,,Acum această fată nu \Nva mai fi un obstacol.
Dialogue: 99,0:25:50.45,0:25:52.87,Dialogue,,0,0,0,,Ar trebui să-mi fii \Nrecunoscătoare, Lilith.
Dialogue: 99,0:25:52.87,0:25:53.91,Dialogue,,0,0,0,,Ce a fost asta?
Dialogue: 99,0:25:54.58,0:25:55.24,Dialogue,,0,0,0,,Ce a fost asta?
Dialogue: 99,0:25:56.45,0:25:57.54,Dialogue,,0,0,0,,Tocmai m-a sărutat.
Dialogue: 99,0:25:58.58,0:26:00.83,Dialogue,,0,0,0,,Acela a fost... primul meu sărut.
Dialogue: 99,0:26:02.58,0:26:03.84,Dialogue,,0,0,0,,Ce e asta? Sânge?
Dialogue: 99,0:26:08.80,0:26:09.72,Dialogue,,0,0,0,,Shin.
Dialogue: 99,0:26:11.01,0:26:11.76,Dialogue,,0,0,0,,Sunt speriată.
Dialogue: 99,0:26:15.85,0:26:16.93,Dialogue,,0,0,0,,Vă mulțumesc că ați venit.
Dialogue: 99,0:26:17.27,0:26:20.56,Dialogue,,0,0,0,,Ea e cu siguranță fetița din rapoarte.
Dialogue: 99,0:26:20.56,0:26:21.10,Dialogue,,0,0,0,,Așa e.
Dialogue: 99,0:26:21.69,0:26:24.27,Dialogue,,0,0,0,,Moroiul din Sarashunou.
Dialogue: 99,0:26:25.48,0:26:27.78,Dialogue,,0,0,0,,Așa este, singurul supraviețuitor.
Dialogue: 99,0:26:28.03,0:26:30.70,Dialogue,,0,0,0,,Presupun că se află în acea \Nclădire în acest moment, nu?
Dialogue: 99,0:26:30.70,0:26:33.20,Dialogue,,0,0,0,,Da, e un loc unde bărbații nu pot intra.
Dialogue: 99,0:26:34.16,0:26:36.03,Dialogue,,0,0,0,,E și băiatul din descendența Romuald?
Dialogue: 99,0:26:37.33,0:26:38.79,Dialogue,,0,0,0,,E timpul pentru exterminare.
Dialogue: 99,0:26:40.12,0:26:41.50,Dialogue,,0,0,0,,Exterminare?
Dialogue: 99,0:26:42.42,0:26:45.17,Dialogue,,0,0,0,,Exterminarea acelor \Nvampiri nemernici.
Dialogue: 99,0:27:05.15,0:27:06.86,Dialogue,,0,0,0,,Asta nu-i a bună!
Dialogue: 99,0:27:08.11,0:27:08.94,Dialogue,,0,0,0,,I-am văzut.
Dialogue: 99,0:27:10.40,0:27:12.36,Dialogue,,0,0,0,,Ce bucurie.
Dialogue: 99,0:27:12.36,0:27:14.16,Dialogue,,0,0,0,,Erau așa de drăguți!
Dialogue: 99,0:27:29.25,0:27:31.63,Dialogue,,0,0,0,,Deci a sosit momentul.
Dialogue: 99,0:27:33.93,0:27:35.18,Dialogue,,0,0,0,,Presupun că voi arunca o privire.
Dialogue: 99,0:27:37.26,0:27:39.10,Dialogue,,0,0,0,,Așteaptă, te rog, dnă asistentă.
Dialogue: 99,0:27:40.10,0:27:41.18,Dialogue,,0,0,0,,Dnă asistentă!
Dialogue: 99,0:27:41.39,0:27:45.69,Dialogue,,0,0,0,,E doar o fetiță. Noi doi \Nne putem ocupa de ea, nu?
Dialogue: 99,0:27:48.90,0:27:51.15,Dialogue,,0,0,0,,Ar trebui să spui ceva \Ndin când în când.
Dialogue: 99,0:27:52.99,0:27:56.07,Dialogue,,0,0,0,,Cammot, ce ar trebui să fac?
Dialogue: 99,0:27:56.07,0:27:59.87,Dialogue,,0,0,0,,Lucrurile nu prea au \Nmers bine în ultima vreme.
Dialogue: 99,0:28:01.83,0:28:03.58,Dialogue,,0,0,0,,Chizuru, tu ești?
Dialogue: 99,0:28:04.25,0:28:05.92,Dialogue,,0,0,0,,Ți-am auzit vocea mai devreme.
Dialogue: 99,0:28:06.00,0:28:07.54,Dialogue,,0,0,0,,Cu cine vorbeai?
Dialogue: 99,0:28:11.17,0:28:11.96,Dialogue,,0,0,0,,Ce?!
Dialogue: 99,0:28:25.02,0:28:27.10,Dialogue,,0,0,0,,Kishimoto?
