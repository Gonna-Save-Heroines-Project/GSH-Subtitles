Comment: 0,0:00:00.00,0:00:00.02,Dialogue,chptr,0,0,0,,{Prolog}
Comment: 0,0:04:53.27,0:04:53.31,Dialogue,chptr,0,0,0,,{OP}
Comment: 0,0:07:09.41,0:07:09.45,Dialogue,chptr,0,0,0,,{Episod}
Comment: 0,0:28:43.04,0:28:43.08,Dialogue,chptr,0,0,0,,{ED}
Dialogue: 99,0:00:16.63,0:00:20.51,Dialogue,,0,0,0,,Și acum, descendent al sângelui \NRomuald, Mizumura Shinta.
Dialogue: 99,0:00:20.51,0:00:25.51,Dialogue,,0,0,0,,Vreau să mă ajuți să dau naștere \Nunei noi ființe de dragul strigoilor.
Dialogue: 99,0:00:52.95,0:00:54.96,Dialogue,,0,0,0,,Chiar îți dorești asta, Kishimoto?
Dialogue: 99,0:01:06.38,0:01:10.97,Dialogue,,0,0,0,,C-C-Ce ar trebui să fac acum?
Dialogue: 99,0:01:20.73,0:01:23.03,Dialogue,,0,0,0,,Kishimoto?
Dialogue: 99,0:01:26.20,0:01:28.16,Dialogue,,0,0,0,,Ce naiba tot așteptați?
Dialogue: 99,0:01:31.53,0:01:34.50,Dialogue,,0,0,0,,Chiar sunteți molâi. \NSimțeam că mor de plictiseală.
Dialogue: 99,0:01:34.50,0:01:37.62,Dialogue,,0,0,0,,Individul ăsta... \No să ne dea ceva bătăi de cap.
Dialogue: 99,0:01:37.62,0:01:39.33,Dialogue,,0,0,0,,Cine naiba ești?
Dialogue: 99,0:01:39.71,0:01:41.84,Dialogue,,0,0,0,,Și ce încerci să faci?
Dialogue: 99,0:01:43.09,0:01:44.34,Dialogue,,0,0,0,,Nu e evident?
Dialogue: 99,0:01:44.34,0:01:46.30,Dialogue,,0,0,0,,Sunt un gardian.
Dialogue: 99,0:01:46.93,0:01:49.89,Dialogue,,0,0,0,,A venit momentul să fiu util.
Dialogue: 99,0:04:08.86,0:04:10.19,Dialogue,,0,0,0,,Î-Îmi pare rău.
Dialogue: 99,0:04:10.19,0:04:13.07,Dialogue,,0,0,0,,Era să fac ceva oribil.
Dialogue: 99,0:04:14.27,0:04:15.95,Dialogue,,0,0,0,,Nu e nevoie să-ți ceri scuze.
Dialogue: 99,0:04:15.95,0:04:18.33,Dialogue,,0,0,0,,Eu îmi doream să se \Nîntâmple acel lucru.
Dialogue: 99,0:04:21.33,0:04:25.75,Dialogue,,0,0,0,,Ei bine... știu că nu ar trebui să spun \Nasta după tot ce s-a întâmplat, dar...
Dialogue: 99,0:04:26.38,0:04:31.01,Dialogue,,0,0,0,,Ar trebui să-ți prețuiești \Ncorpul, Kishimoto.
Dialogue: 99,0:04:33.18,0:04:34.44,Dialogue,,0,0,0,,Ești așa de inutil.
Dialogue: 99,0:04:39.89,0:04:42.42,Dialogue,,0,0,0,,Oare mă urăște acum?
Dialogue: 99,0:04:48.31,0:04:51.69,Dialogue,,0,0,0,,La naiba! Ne-a tăbăcit fundul.
Dialogue: 99,0:04:52.53,0:04:55.36,Dialogue,,0,0,0,,Dacă tot ești atât de șifonat...
Dialogue: 99,0:04:55.36,0:04:56.82,Dialogue,,0,0,0,,De ce-mi dai peste mână?
Dialogue: 99,0:04:56.82,0:04:59.33,Dialogue,,0,0,0,,Doar încercam să te ajut.
Dialogue: 99,0:05:00.70,0:05:02.91,Dialogue,,0,0,0,,Deci avea o gardă de corp, nu?
Dialogue: 99,0:05:03.19,0:05:04.98,Dialogue,,0,0,0,,Succesul misiunii.
Dialogue: 99,0:05:04.98,0:05:07.70,Dialogue,,0,0,0,,Trebuie să ne punem \Nviața în joc pentru el.
Dialogue: 99,0:05:07.71,0:05:08.79,Dialogue,,0,0,0,,Comandante Cliff...
Dialogue: 99,0:05:08.79,0:05:10.30,Dialogue,,0,0,0,,Necesitate.
Dialogue: 99,0:05:10.30,0:05:15.09,Dialogue,,0,0,0,,Trebuie să fim și deștepți, \Nși rapizi în următoarea operațiune.
Dialogue: 99,0:05:15.09,0:05:16.93,Dialogue,,0,0,0,,Nu vom mai da greș.
Dialogue: 99,0:05:17.33,0:05:19.80,Dialogue,,0,0,0,,Atunci, vom avea nevoie de întăriri.
Dialogue: 99,0:05:19.80,0:05:20.85,Dialogue,,0,0,0,,Doar de arme avem nevoie.
Dialogue: 99,0:05:22.06,0:05:23.31,Dialogue,,0,0,0,,Știe să vorbească!
Dialogue: 99,0:05:23.31,0:05:24.23,Dialogue,,0,0,0,,Așa este...
Dialogue: 99,0:05:25.60,0:05:30.86,Dialogue,,0,0,0,,În tragedia din Sarashunou, o anumită \Nfemeie ne-a dat mari bătăi de cap.
Dialogue: 99,0:05:34.70,0:05:36.99,Dialogue,,0,0,0,,Vă voi lua pe toți cu mine.
Dialogue: 99,0:05:41.33,0:05:43.24,Dialogue,,0,0,0,,Retragerea! Retrageți-vă imediat!
Dialogue: 99,0:05:43.95,0:05:46.75,Dialogue,,0,0,0,,Adio, Lilith.
Dialogue: 99,0:05:56.63,0:05:59.18,Dialogue,,0,0,0,,Comandante Cliff, ești bine?
Dialogue: 99,0:05:59.50,0:06:05.81,Dialogue,,0,0,0,,La naiba. Acea femeie nebună a reușit \Nsă-l elimine pe căpitanul Odin Romuald.
Dialogue: 99,0:06:11.93,0:06:14.03,Dialogue,,0,0,0,,Mamă. Tată.
Dialogue: 99,0:06:14.78,0:06:16.74,Dialogue,,0,0,0,,Unde este mami?
Dialogue: 99,0:06:16.74,0:06:20.11,Dialogue,,0,0,0,,Lilith, mami avea ceva \Nimportant de făcut.
Dialogue: 99,0:06:20.45,0:06:22.87,Dialogue,,0,0,0,,Vreau s-o văd. \NVreau s-o văd pe mami.
Dialogue: 99,0:06:23.11,0:06:26.83,Dialogue,,0,0,0,,Pentru că ești o fetiță cuminte \Nîți voi da acest pandantiv.
Dialogue: 99,0:06:27.91,0:06:31.33,Dialogue,,0,0,0,,Acesta este singurul lucru \Npe care ți-l pot oferi părinții tăi.
Dialogue: 99,0:06:32.09,0:06:33.38,Dialogue,,0,0,0,,Haide acum.
Dialogue: 99,0:06:40.51,0:06:46.39,Dialogue,,0,0,0,,{\q2\i1}Sunt singurul supraviețuitor al incidentului din \NSarashunou deoarece am fost protejată de părinții mei.
Dialogue: 99,0:06:46.98,0:06:47.64,Dialogue,,0,0,0,,{\i1}De asta...
Dialogue: 99,0:06:48.77,0:06:52.52,Dialogue,,0,0,0,,{\i1}Nu voi muri până nu-mi \Nduc la bun sfârșit misiunea.
Dialogue: 99,0:06:56.28,0:06:57.74,Dialogue,,0,0,0,,Hei, privește.
Dialogue: 99,0:06:58.17,0:07:00.74,Dialogue,,0,0,0,,Scârbos. Privește cum se sărută.
Dialogue: 99,0:07:00.74,0:07:02.95,Dialogue,,0,0,0,,Parcă nici n-ar fi în public.
Dialogue: 99,0:07:02.95,0:07:05.95,Dialogue,,0,0,0,,Eu și iubitul meu nu suntem \Ndeloc atât de obsceni.
Dialogue: 99,0:07:05.95,0:07:08.75,Dialogue,,0,0,0,,Scârbos. Și ai vrea să \Nvă sărutați și voi la fel?
Dialogue: 99,0:07:09.29,0:07:10.25,Dialogue,,0,0,0,,Să mergem.
Dialogue: 99,0:07:10.25,0:07:11.17,Dialogue,,0,0,0,,Hei, așteaptă.
Dialogue: 99,0:07:12.46,0:07:14.59,Dialogue,,0,0,0,,Aveam nevoie de o mică gustărică.
Dialogue: 99,0:07:17.08,0:07:19.26,Dialogue,,0,0,0,,Hei, cineva a leșinat aici.
Dialogue: 99,0:07:22.43,0:07:23.89,Dialogue,,0,0,0,,{\i1}Oamenii încep să observe.
Dialogue: 99,0:07:30.73,0:07:31.94,Dialogue,,0,0,0,,{\i1}Să plecăm de aici.
Dialogue: 99,0:07:38.94,0:07:40.57,Dialogue,,0,0,0,,{\i1}Shinta...
Dialogue: 99,0:07:40.57,0:07:43.16,Dialogue,,0,0,0,,{\i1}Chiar era serios.
Dialogue: 99,0:07:43.82,0:07:45.19,Dialogue,,0,0,0,,{\i1}Acea privire...
Dialogue: 99,0:07:45.73,0:07:48.54,Dialogue,,0,0,0,,{\i1}Parcă era gata să mă devoreze.
Dialogue: 99,0:07:49.66,0:07:51.83,Dialogue,,0,0,0,,{\i1}Deci și Shinta are astfel de dorințe.
Dialogue: 99,0:07:51.83,0:07:53.92,Dialogue,,0,0,0,,{\i1}Se pare că toți băieții își doresc asta.
Dialogue: 99,0:07:53.92,0:07:56.21,Dialogue,,0,0,0,,{\i1}Eu... Eu...
Dialogue: 99,0:07:59.09,0:08:00.63,Dialogue,,0,0,0,,K-Kamiura?
Dialogue: 99,0:08:00.63,0:08:02.05,Dialogue,,0,0,0,,Uau, ești tare.
Dialogue: 99,0:08:02.05,0:08:03.89,Dialogue,,0,0,0,,Ai reușit să-ți dai \Nseama că sunt eu.
Dialogue: 99,0:08:03.89,0:08:05.05,Dialogue,,0,0,0,,Mă bucur foarte mult.
Dialogue: 99,0:08:05.32,0:08:07.56,Dialogue,,0,0,0,,Ce cauți aici?
Dialogue: 99,0:08:07.56,0:08:08.64,Dialogue,,0,0,0,,Cum ai intrat?
Dialogue: 99,0:08:08.64,0:08:11.43,Dialogue,,0,0,0,,Ce? Eu sunt protectoarea ta.
Dialogue: 99,0:08:11.43,0:08:14.65,Dialogue,,0,0,0,,Iar ca protectoarea ta, trebuie să fiu mereu \Nlângă tine și să te îmbrățișez astfel.
Dialogue: 99,0:08:14.65,0:08:17.07,Dialogue,,0,0,0,,Nu, nu trebuie, Kamiura.
Dialogue: 99,0:08:17.07,0:08:19.36,Dialogue,,0,0,0,,Ești timidă?
Dialogue: 99,0:08:19.36,0:08:20.49,Dialogue,,0,0,0,,Nu-ți voi da drumul.
Dialogue: 99,0:08:20.99,0:08:21.65,Dialogue,,0,0,0,,Încetează!
Dialogue: 99,0:08:23.32,0:08:25.03,Dialogue,,0,0,0,,Fundul ți-a crescut, \Ndar talia ți-a rămas suplă.
Dialogue: 99,0:08:25.58,0:08:29.37,Dialogue,,0,0,0,,Să fie oare pentru că \Nți-ai tras-o cu iubitul tău?
Dialogue: 99,0:08:29.37,0:08:30.62,Dialogue,,0,0,0,,Trebuie să fi fost delicios.
Dialogue: 99,0:08:30.62,0:08:32.50,Dialogue,,0,0,0,,Sunt foarte geloasă pe tine.
Dialogue: 99,0:08:33.33,0:08:36.25,Dialogue,,0,0,0,,De asta ai venit aici?
Dialogue: 99,0:08:36.25,0:08:37.29,Dialogue,,0,0,0,,Exact.
Dialogue: 99,0:08:37.29,0:08:42.67,Dialogue,,0,0,0,,Voiam să gust și eu puțin din tine.
Dialogue: 99,0:08:42.95,0:08:45.43,Dialogue,,0,0,0,,Deci, deci? Te-a luat tare?
Dialogue: 99,0:08:45.43,0:08:47.35,Dialogue,,0,0,0,,De ce mă întrebi așa ceva?
Dialogue: 99,0:08:47.35,0:08:48.97,Dialogue,,0,0,0,,Relaxează-te, bine?
Dialogue: 99,0:08:51.70,0:08:53.81,Dialogue,,0,0,0,,Sigur mă urăște acum.
Dialogue: 99,0:08:59.07,0:09:02.69,Dialogue,,0,0,0,,Hei, hei, Lilith. Ascultă, ascultă!
Dialogue: 99,0:09:02.69,0:09:07.53,Dialogue,,0,0,0,,Niște tipi au încercat să te întrerupă, \Ndar le-am tăbăcit fundul.
Dialogue: 99,0:09:07.53,0:09:08.83,Dialogue,,0,0,0,,Sunt grozav, nu-i așa?
Dialogue: 99,0:09:08.83,0:09:11.61,Dialogue,,0,0,0,,Laudă-mă, Lilith.
Dialogue: 99,0:09:11.61,0:09:12.50,Dialogue,,0,0,0,,Laudă-mă, laudă—
Dialogue: 99,0:09:12.87,0:09:16.58,Dialogue,,0,0,0,,Ce naiba cauți acolo jos?
Dialogue: 99,0:09:16.58,0:09:18.08,Dialogue,,0,0,0,,Văd că ai rămas la fel de urât.
Dialogue: 99,0:09:19.17,0:09:20.63,Dialogue,,0,0,0,,Kamiura?
Dialogue: 99,0:09:21.13,0:09:24.38,Dialogue,,0,0,0,,De ce ești aici și când ai intrat?
Dialogue: 99,0:09:24.38,0:09:25.93,Dialogue,,0,0,0,,Stai, ce spuneam?
Dialogue: 99,0:09:27.16,0:09:29.85,Dialogue,,0,0,0,,Nu se presupunea că \Nești gardianul lui Lilith?
Dialogue: 99,0:09:29.85,0:09:31.72,Dialogue,,0,0,0,,Ar trebui s-o aperi, \Nnu să sforăi în pat.
Dialogue: 99,0:09:31.72,0:09:33.47,Dialogue,,0,0,0,,Fă-ți treaba, câine spurcat.
Dialogue: 99,0:09:34.53,0:09:36.56,Dialogue,,0,0,0,,Să știi că fac o treabă \Nfoarte bună protejând-o!
Dialogue: 99,0:09:36.56,0:09:37.65,Dialogue,,0,0,0,,Ne mai vedem, câine spurcat.
Dialogue: 99,0:09:37.65,0:09:38.52,Dialogue,,0,0,0,,Ce?
Dialogue: 99,0:09:40.65,0:09:43.53,Dialogue,,0,0,0,,Care naiba e problema ei?
Dialogue: 99,0:09:43.53,0:09:46.61,Dialogue,,0,0,0,,Nu ne-am mai văzut de mult \Ntimp și așa se comportă?
Dialogue: 99,0:09:49.16,0:09:50.70,Dialogue,,0,0,0,,Aici erai, Plum?
Dialogue: 99,0:09:56.36,0:09:57.96,Dialogue,,0,0,0,,Oprește-te...
Dialogue: 99,0:10:18.06,0:10:19.35,Dialogue,,0,0,0,,Știu.
Dialogue: 99,0:10:19.35,0:10:21.19,Dialogue,,0,0,0,,Destinul meu inevitabil.
Dialogue: 99,0:10:21.90,0:10:26.69,Dialogue,,0,0,0,,Însemnul de pe pieptul tău e \Ndovada jurământului de moroi.
Dialogue: 99,0:10:27.40,0:10:30.49,Dialogue,,0,0,0,,Misiunea ta e să dai naștere unui \Ncopil din descendența Romuald,
Dialogue: 99,0:10:30.49,0:10:32.83,Dialogue,,0,0,0,,să-i ucizi și pe tată, și pe copil, \Niar apoi să te scalzi în sângele lor.
Dialogue: 99,0:10:32.83,0:10:36.75,Dialogue,,0,0,0,,Un adevărat act just \Npentru binele strigoilor.
Dialogue: 99,0:10:37.71,0:10:43.71,Dialogue,,0,0,0,,Dacă nu o vei îndeplini, acel însemn \Nva deveni blestemul tău pentru eternitate.
Dialogue: 99,0:10:45.71,0:10:50.51,Dialogue,,0,0,0,,Kamiura, nu-mi este teamă \Nsă-mi pierd virginitatea.
Dialogue: 99,0:10:50.51,0:10:53.93,Dialogue,,0,0,0,,Orice s-ar întâmpla, îți voi arăta \Ncă îi voi avea copilul în pântece.
Dialogue: 99,0:10:53.93,0:10:56.02,Dialogue,,0,0,0,,Sunt extrem de hotărâtă.
Dialogue: 99,0:10:58.27,0:11:00.69,Dialogue,,0,0,0,,Mă simt mai bine acum \Ncă am auzit acele cuvinte.
Dialogue: 99,0:11:12.45,0:11:13.95,Dialogue,,0,0,0,,{\i1}Kishimoto...
Dialogue: 99,0:11:13.95,0:11:16.45,Dialogue,,0,0,0,,{\i1}Se uită la ea chiar și \Natunci când stă lângă mine?
Dialogue: 99,0:11:16.45,0:11:19.16,Dialogue,,0,0,0,,{\i1}Nu-l voi ierta pentru asta.
Dialogue: 99,0:11:19.50,0:11:23.25,Dialogue,,0,0,0,,{\i1}Se uită la mine încă \Nde la începutul orei.
Dialogue: 99,0:11:24.17,0:11:25.84,Dialogue,,0,0,0,,{\i1}Se pare că nu mă urăște.
Dialogue: 99,0:11:25.84,0:11:27.05,Dialogue,,0,0,0,,{\i1}Ce bine.
Dialogue: 99,0:11:29.34,0:11:33.68,Dialogue,,0,0,0,,{\i1}Shin, amândoi am venit din Kyushu.
Dialogue: 99,0:11:33.68,0:11:37.68,Dialogue,,0,0,0,,{\i1}Nu înțelegi? O prietenă din \Ncopilărie nu are cum să piardă.
Dialogue: 99,0:11:37.72,0:11:41.10,Dialogue,,0,0,0,,{\i1}Nu voi pierde în fața acelei fete.
Dialogue: 99,0:11:41.10,0:11:43.35,Dialogue,,0,0,0,,{\i1}M-ai auzit, Shin?
Dialogue: 99,0:11:43.35,0:11:44.19,Dialogue,,0,0,0,,Auci.
Dialogue: 99,0:11:45.48,0:11:47.48,Dialogue,,0,0,0,,{\i1}Sângerez.
Dialogue: 99,0:11:48.02,0:11:49.36,Dialogue,,0,0,0,,{\i1}Vai...
Dialogue: 99,0:11:50.32,0:11:52.45,Dialogue,,0,0,0,,{\i1}Oare e adâncă...
Dialogue: 99,0:11:52.99,0:11:53.70,Dialogue,,0,0,0,,{\i1}Ce?
Dialogue: 99,0:11:54.53,0:11:56.83,Dialogue,,0,0,0,,{\i1}Rana a dispărut?
Dialogue: 99,0:12:03.58,0:12:04.96,Dialogue,,0,0,0,,Modul zen.
Dialogue: 99,0:12:05.19,0:12:06.38,Dialogue,,0,0,0,,Ce înseamnă asta?
Dialogue: 99,0:12:06.38,0:12:09.84,Dialogue,,0,0,0,,Această briză proaspătă mă relaxează.
Dialogue: 99,0:12:09.84,0:12:11.42,Dialogue,,0,0,0,,Nu prea înțeleg.
Dialogue: 99,0:12:11.42,0:12:12.55,Dialogue,,0,0,0,,Serios?
Dialogue: 99,0:12:12.55,0:12:14.55,Dialogue,,0,0,0,,Deci ce vom face în legătură cu el?
Dialogue: 99,0:12:14.55,0:12:17.64,Dialogue,,0,0,0,,Chiar îl vom forța să se trezească?
Dialogue: 99,0:12:17.64,0:12:19.22,Dialogue,,0,0,0,,Comandante Cliff Strife.
Dialogue: 99,0:12:19.46,0:12:21.77,Dialogue,,0,0,0,,Este un descendent \Nal familiei Romuald.
Dialogue: 99,0:12:21.77,0:12:24.98,Dialogue,,0,0,0,,Ar fi grozav dacă \Nam reuși s-o facem.
Dialogue: 99,0:12:24.98,0:12:26.19,Dialogue,,0,0,0,,Nu văd vreo problemă cu asta.
Dialogue: 99,0:12:26.19,0:12:27.98,Dialogue,,0,0,0,,Avem nevoie de el ca \Nsă ne ocupăm de strigoi.
Dialogue: 99,0:12:28.26,0:12:30.90,Dialogue,,0,0,0,,Ar fi grozav dacă ar coopera cu noi.
Dialogue: 99,0:12:32.03,0:12:34.36,Dialogue,,0,0,0,,Mai ales în eliminarea moroilor.
Dialogue: 99,0:12:34.36,0:12:37.66,Dialogue,,0,0,0,,Nu știu dacă oamenii \Nacestei lumi pot face față
Dialogue: 99,0:12:37.66,0:12:40.87,Dialogue,,0,0,0,,la toate aceste lucruri ciudate.
Dialogue: 99,0:12:40.87,0:12:41.75,Dialogue,,0,0,0,,Practic,
Dialogue: 99,0:12:43.41,0:12:45.38,Dialogue,,0,0,0,,avem nevoie de el,
Dialogue: 99,0:12:45.38,0:12:46.33,Dialogue,,0,0,0,,nu?
Dialogue: 99,0:12:50.05,0:12:51.84,Dialogue,,0,0,0,,Ce ai acolo, Cammot?
Dialogue: 99,0:12:51.84,0:12:54.22,Dialogue,,0,0,0,,Hei, nu te juca cu asta.
Dialogue: 99,0:12:54.22,0:12:56.01,Dialogue,,0,0,0,,Am primit-o de la bunicul
Dialogue: 99,0:12:56.01,0:12:57.35,Dialogue,,0,0,0,,și e o amintire de la mama mea.
Dialogue: 99,0:12:59.64,0:13:03.02,Dialogue,,0,0,0,,Se simte de parcă ar fi o piatră aici.
Dialogue: 99,0:13:03.02,0:13:04.69,Dialogue,,0,0,0,,Ce e chestia asta?
Dialogue: 99,0:13:05.91,0:13:07.90,Dialogue,,0,0,0,,A fost mereu acolo?
Dialogue: 99,0:13:10.69,0:13:11.65,Dialogue,,0,0,0,,{\i1}Pieptul...
Dialogue: 99,0:13:11.65,0:13:12.69,Dialogue,,0,0,0,,{\i1}a început să mă doară...
Dialogue: 99,0:13:13.86,0:13:17.12,Dialogue,,0,0,0,,Oh, Shinta se trezește.
Dialogue: 99,0:13:19.33,0:13:20.08,Dialogue,,0,0,0,,C-Cammot?
Dialogue: 99,0:13:20.08,0:13:21.66,Dialogue,,0,0,0,,Se pare că te-ai trezit.
Dialogue: 99,0:13:21.66,0:13:24.50,Dialogue,,0,0,0,,Au spus că o vei face.
Dialogue: 99,0:13:25.00,0:13:26.92,Dialogue,,0,0,0,,Ce?! C-Cammot?
Dialogue: 99,0:13:26.92,0:13:29.17,Dialogue,,0,0,0,,Ești Cammot, nu-i așa?
Dialogue: 99,0:13:29.45,0:13:32.42,Dialogue,,0,0,0,,Shinta, multe lucruri înfricoșătoare \Nsunt pe cale să înceapă.
Dialogue: 99,0:13:32.42,0:13:34.13,Dialogue,,0,0,0,,Ar fi bine să ai grijă.
Dialogue: 99,0:13:34.13,0:13:35.17,Dialogue,,0,0,0,,Dar...
Dialogue: 99,0:13:36.13,0:13:37.51,Dialogue,,0,0,0,,Totul e bine!
Dialogue: 99,0:13:37.51,0:13:39.68,Dialogue,,0,0,0,,Cammot e aici cu tine!
Dialogue: 99,0:13:48.56,0:13:50.69,Dialogue,,0,0,0,,Nu am aterizat cum trebuie.
Dialogue: 99,0:13:51.77,0:13:54.32,Dialogue,,0,0,0,,Oh, Shinta. Te mai doare pieptul?
Dialogue: 99,0:13:54.67,0:13:56.45,Dialogue,,0,0,0,,Ce? Mă simt bine acum.
Dialogue: 99,0:13:56.45,0:13:58.66,Dialogue,,0,0,0,,Dar cine ești, mai exact?
Dialogue: 99,0:13:59.32,0:14:00.78,Dialogue,,0,0,0,,Sunt Cammot.
Dialogue: 99,0:14:01.35,0:14:01.83,Dialogue,,0,0,0,,Cammo—
Dialogue: 99,0:14:01.83,0:14:03.66,Dialogue,,0,0,0,,Totul e bine!
Dialogue: 99,0:14:04.75,0:14:05.87,Dialogue,,0,0,0,,Nu ești o pisică?
Dialogue: 99,0:14:05.87,0:14:07.79,Dialogue,,0,0,0,,Totul e bine!
Dialogue: 99,0:14:08.25,0:14:10.38,Dialogue,,0,0,0,,Cammot e de partea ta.
Dialogue: 99,0:14:10.62,0:14:12.55,Dialogue,,0,0,0,,Dar de ce o pisică poate vorbi...
Dialogue: 99,0:14:12.55,0:14:13.71,Dialogue,,0,0,0,,Totul e bine!
Dialogue: 99,0:14:14.55,0:14:17.93,Dialogue,,0,0,0,,Cât timp sunt aici, totul va fi bine!
Dialogue: 99,0:14:17.93,0:14:20.01,Dialogue,,0,0,0,,Oh, da, Shinta...
Dialogue: 99,0:14:20.85,0:14:24.72,Dialogue,,0,0,0,,Ai grijă la acea fată cu părul și ochii roșii.
Dialogue: 99,0:14:25.00,0:14:27.19,Dialogue,,0,0,0,,Ce? Părul și ochii roșii?
Dialogue: 99,0:14:32.82,0:14:34.19,Dialogue,,0,0,0,,Citește astea.
Dialogue: 99,0:14:34.19,0:14:35.49,Dialogue,,0,0,0,,Ce sunt astea?
Dialogue: 99,0:14:35.49,0:14:37.45,Dialogue,,0,0,0,,„Jurnal despre Shinta \Ncel Fără Speranță”?
Dialogue: 99,0:14:37.45,0:14:39.41,Dialogue,,0,0,0,,Acesta conține...
Dialogue: 99,0:14:39.82,0:14:42.66,Dialogue,,0,0,0,,prima zi perversă a lui Shinta.
Dialogue: 99,0:14:42.66,0:14:46.75,Dialogue,,0,0,0,,Tot aici e descris și momentul când Shinta s-a panicat \Npentru că îi crescuse un tuficel în zona intimă.
Dialogue: 99,0:14:46.75,0:14:50.75,Dialogue,,0,0,0,,Stai puțin! Nu m-am \Npanicat din cauza tufi—
Dialogue: 99,0:14:50.75,0:14:52.25,Dialogue,,0,0,0,,Stai, tuficel?!
Dialogue: 99,0:14:52.25,0:14:53.84,Dialogue,,0,0,0,,Totul e în regulă!
Dialogue: 99,0:14:53.84,0:14:56.80,Dialogue,,0,0,0,,Am fost mereu lângă tine, \Nașa că mă poți întreba orice.
Dialogue: 99,0:14:56.80,0:14:59.09,Dialogue,,0,0,0,,Nu e vorba de asta...
Dialogue: 99,0:15:02.69,0:15:05.64,Dialogue,,0,0,0,,Chiar tu ai scris toate astea, Cammot?
Dialogue: 99,0:15:08.56,0:15:11.10,Dialogue,,0,0,0,,Aici e relatată ziua \Ncând a murit mama.
Dialogue: 99,0:15:11.77,0:15:13.44,Dialogue,,0,0,0,,Iar aici ziua când a murit bunicul.
Dialogue: 99,0:15:13.82,0:15:15.32,Dialogue,,0,0,0,,Romuald?
Dialogue: 99,0:15:15.32,0:15:19.40,Dialogue,,0,0,0,,Unde am mai auzit acest cuvânt?
Dialogue: 99,0:15:19.40,0:15:21.32,Dialogue,,0,0,0,,Descendența Romuald...
Dialogue: 99,0:15:24.08,0:15:26.70,Dialogue,,0,0,0,,{\fad(0,717)}Kishimoto...
Dialogue: 99,0:15:27.66,0:15:29.75,Dialogue,,0,0,0,,De la ea am auzit acel cuvânt.
Dialogue: 99,0:15:33.29,0:15:37.67,Dialogue,,0,0,0,,{\i1}Kishimoto, cine ești, mai exact?
Dialogue: 99,0:15:41.51,0:15:43.09,Dialogue,,0,0,0,,{\i1}Descendența Romuald...
Dialogue: 99,0:15:43.55,0:15:46.06,Dialogue,,0,0,0,,{\i1}Nu a fost prima oară când \Nam auzit aceste cuvinte.
Dialogue: 99,0:15:46.06,0:15:48.85,Dialogue,,0,0,0,,{\i1}Bunicul obișnuia să \Nvorbească despre asta.
Dialogue: 99,0:15:49.77,0:15:51.98,Dialogue,,0,0,0,,{\i1}Degeaba. Nu reușesc \Nsă-mi amintesc nimic.
Dialogue: 99,0:15:54.06,0:15:54.86,Dialogue,,0,0,0,,{\i1}Ce naiba?
Dialogue: 99,0:16:00.53,0:16:01.53,Dialogue,,0,0,0,,C-Ce se petrece?
Dialogue: 99,0:16:02.20,0:16:03.99,Dialogue,,0,0,0,,S-Sakamoto?
Dialogue: 99,0:16:05.45,0:16:06.53,Dialogue,,0,0,0,,Descendența Romuald.
Dialogue: 99,0:16:09.82,0:16:13.33,Dialogue,,0,0,0,,Dragostea dintre un strigoi și \Nun vânător nu va fi permisă,
Dialogue: 99,0:16:13.33,0:16:16.46,Dialogue,,0,0,0,,deoarece sângele ce-ți curge \Nprin vene îți va sta în cale.
Dialogue: 99,0:16:16.99,0:16:19.38,Dialogue,,0,0,0,,Sângele meu îmi va sta în cale?
Dialogue: 99,0:16:20.05,0:16:21.47,Dialogue,,0,0,0,,Hei, Sakamoto.
Dialogue: 99,0:16:24.64,0:16:26.64,Dialogue,,0,0,0,,Oh, Shin?
Dialogue: 99,0:16:26.64,0:16:29.10,Dialogue,,0,0,0,,Ce faci aici?
Dialogue: 99,0:16:29.72,0:16:31.56,Dialogue,,0,0,0,,Haide să luăm prânzul împreună.
Dialogue: 99,0:16:33.31,0:16:35.81,Dialogue,,0,0,0,,Îmi pare rău, dar nu pot astăzi.
Dialogue: 99,0:16:35.81,0:16:38.73,Dialogue,,0,0,0,,Ce?! De ce?!
Dialogue: 99,0:16:39.53,0:16:41.99,Dialogue,,0,0,0,,Nu te simți bine?
Dialogue: 99,0:16:41.99,0:16:45.16,Dialogue,,0,0,0,,Nu. Doar am nevoie de puțin timp \Nsingur ca să mă gândesc la unele lucruri.
Dialogue: 99,0:16:45.79,0:16:46.57,Dialogue,,0,0,0,,Îmi pare rău.
Dialogue: 99,0:16:47.07,0:16:48.70,Dialogue,,0,0,0,,Stai puțin, Shin.
Dialogue: 99,0:16:49.45,0:16:52.96,Dialogue,,0,0,0,,{\i1}Voiam să-ți spun ceva.
Dialogue: 99,0:16:55.69,0:16:58.75,Dialogue,,0,0,0,,{\i1}Corpul meu se comportă ciudat.
Dialogue: 99,0:16:58.75,0:17:01.30,Dialogue,,0,0,0,,{\i1}M-am tăiat la deget, \Niar sângerarea s-a oprit imediat.
Dialogue: 99,0:17:02.05,0:17:08.76,Dialogue,,0,0,0,,{\i1}Deși mă durea foarte tare, \Nrana a dispărut cât ai clipi.
Dialogue: 99,0:17:09.43,0:17:12.52,Dialogue,,0,0,0,,{\i1}De parcă nu aș mai fi om.
Dialogue: 99,0:17:13.02,0:17:14.81,Dialogue,,0,0,0,,{\i1}E ciudat, nu-i așa?
Dialogue: 99,0:17:16.19,0:17:17.90,Dialogue,,0,0,0,,{\i1}Ajută-mă, Shin.
Dialogue: 99,0:17:18.88,0:17:20.72,Dialogue,,0,0,0,,{\i1}Sunt speriată.
Dialogue: 99,0:17:23.24,0:17:24.74,Dialogue,,0,0,0,,Gloanțe de argint...
Dialogue: 99,0:17:24.74,0:17:27.20,Dialogue,,0,0,0,,Curând, toate vor fi binecuvântare.
Dialogue: 99,0:17:28.28,0:17:30.91,Dialogue,,0,0,0,,Sediul central ne-a trimis multe \Njucării alături de acea scrisoare.
Dialogue: 99,0:17:30.91,0:17:32.16,Dialogue,,0,0,0,,Înarmați până în dinți.
Dialogue: 99,0:17:32.41,0:17:37.00,Dialogue,,0,0,0,,Asta arată cât de mult își doresc \Nca misiunea să fie un succes.
Dialogue: 99,0:17:38.38,0:17:40.67,Dialogue,,0,0,0,,Vor să avem un avantaj \Ndacă ceva merge prost
Dialogue: 99,0:17:40.67,0:17:43.42,Dialogue,,0,0,0,,când se va trezi băiatul Romuald.
Dialogue: 99,0:17:43.86,0:17:49.30,Dialogue,,0,0,0,,Probabil va ucide ținta \Ncând se va întâmpla asta.
Dialogue: 99,0:17:49.95,0:17:51.76,Dialogue,,0,0,0,,Doamne ajută.
Dialogue: 99,0:18:06.70,0:18:08.66,Dialogue,,0,0,0,,Mâncarea mea preferată.
Dialogue: 99,0:18:08.66,0:18:11.33,Dialogue,,0,0,0,,Ba chiar are și miere.
Dialogue: 99,0:18:12.24,0:18:13.87,Dialogue,,0,0,0,,Va fi un dezmăț în seara asta.
Dialogue: 99,0:18:21.50,0:18:23.50,Dialogue,,0,0,0,,Un lanț de argint...
Dialogue: 99,0:18:23.50,0:18:25.97,Dialogue,,0,0,0,,Ai grijă, Lilith.
Dialogue: 99,0:18:26.93,0:18:28.84,Dialogue,,0,0,0,,Te-am trezit cumva?
Dialogue: 99,0:18:28.84,0:18:32.51,Dialogue,,0,0,0,,Scuze, dar trebuie să vii cu mine.
Dialogue: 99,0:18:37.52,0:18:39.35,Dialogue,,0,0,0,,Îmi pare rău, Lilith.
Dialogue: 99,0:18:39.35,0:18:41.61,Dialogue,,0,0,0,,Aceste lanțuri de argint \Nîmi limitează puterile.
Dialogue: 99,0:18:47.40,0:18:49.78,Dialogue,,0,0,0,,Da, cine este?
Dialogue: 99,0:18:53.03,0:18:54.33,Dialogue,,0,0,0,,Asta este...
Dialogue: 99,0:18:54.33,0:18:56.87,Dialogue,,0,0,0,,Un mesaj de la dl profesor Cliff.
Dialogue: 99,0:19:02.59,0:19:03.84,Dialogue,,0,0,0,,Ce priveliște frumoasă.
Dialogue: 99,0:19:04.55,0:19:05.88,Dialogue,,0,0,0,,Acum mult timp,
Dialogue: 99,0:19:05.88,0:19:09.80,Dialogue,,0,0,0,,oamenii neascultători \Nerau umiliți în public
Dialogue: 99,0:19:09.80,0:19:12.47,Dialogue,,0,0,0,,prin scufundare în apă, \Nla ordinul lordului.
Dialogue: 99,0:19:14.22,0:19:17.14,Dialogue,,0,0,0,,Pot spune că și eu asist \Nla o scenă asemănătoare.
Dialogue: 99,0:19:19.56,0:19:21.65,Dialogue,,0,0,0,,Nu știu dacă ai observat,
Dialogue: 99,0:19:22.73,0:19:26.03,Dialogue,,0,0,0,,dar aceste arme sunt \Npline cu gloanțe de argint.
Dialogue: 99,0:19:27.66,0:19:31.53,Dialogue,,0,0,0,,Dacă te-aș împușca, \Nte-ai transforma în cenușă,
Dialogue: 99,0:19:31.53,0:19:33.49,Dialogue,,0,0,0,,ceea ce ar dovedi că nu ești om.
Dialogue: 99,0:19:34.77,0:19:37.08,Dialogue,,0,0,0,,Nu-ți dorești ca strigoii \Nsă dispară, nu-i așa?
Dialogue: 99,0:19:37.08,0:19:38.83,Dialogue,,0,0,0,,Imploră-mă să te las în viață.
Dialogue: 99,0:19:39.71,0:19:40.79,Dialogue,,0,0,0,,Haide!
Dialogue: 99,0:19:41.83,0:19:42.96,Dialogue,,0,0,0,,Cât de frumos.
Dialogue: 99,0:19:42.96,0:19:47.93,Dialogue,,0,0,0,,Te voi ucide cu această armă indiferent \Ncât de mult m-ai implora să te cruț.
Dialogue: 99,0:19:48.30,0:19:49.30,Dialogue,,0,0,0,,Ai grijă.
Dialogue: 99,0:19:49.30,0:19:52.30,Dialogue,,0,0,0,,Nu vorbi că s-ar putea \Nsă se descarce accidental.
Dialogue: 99,0:19:52.30,0:19:53.64,Dialogue,,0,0,0,,Exact așa...
Dialogue: 99,0:19:57.97,0:19:59.35,Dialogue,,0,0,0,,Îmi pare rău să te dezamăgesc,
Dialogue: 99,0:19:59.35,0:20:02.60,Dialogue,,0,0,0,,dar nu eu voi apăsa pe trăgaci.
Dialogue: 99,0:20:02.60,0:20:06.23,Dialogue,,0,0,0,,Cel care o va face va ajunge curând.
Dialogue: 99,0:20:06.23,0:20:09.36,Dialogue,,0,0,0,,Așa că fii cuminte până atunci.
Dialogue: 99,0:20:12.61,0:20:17.08,Dialogue,,0,0,0,,P-Perversule, chiar e atât de \Ndistractiv să te joci cu viețile altora?
Dialogue: 99,0:20:18.29,0:20:19.37,Dialogue,,0,0,0,,Nu am terminat încă.
Dialogue: 99,0:20:23.89,0:20:25.79,Dialogue,,0,0,0,,O piele așa de albă și rece.
Dialogue: 99,0:20:25.79,0:20:26.96,Dialogue,,0,0,0,,Ce încerci să faci?
Dialogue: 99,0:20:26.96,0:20:28.25,Dialogue,,0,0,0,,Ia te uită,
Dialogue: 99,0:20:28.25,0:20:33.09,Dialogue,,0,0,0,,sfârcul se ridică când te apăs.
Dialogue: 99,0:20:33.09,0:20:36.89,Dialogue,,0,0,0,,Corpul tău nu e rău deloc.
Dialogue: 99,0:20:37.32,0:20:42.19,Dialogue,,0,0,0,,Credeam că pielea ta albă și rece a \Nunui strigoi ar fi mai greu de penetrat.
Dialogue: 99,0:20:42.19,0:20:43.51,Dialogue,,0,0,0,,Mai taci!
Dialogue: 99,0:20:43.51,0:20:45.69,Dialogue,,0,0,0,,Oare cu ce ar trebui să continui?
Dialogue: 99,0:20:45.69,0:20:48.02,Dialogue,,0,0,0,,Să mă joc oare cu buricul tău?
Dialogue: 99,0:20:48.02,0:20:52.15,Dialogue,,0,0,0,,Sau poate ar trebui să-mi \Nîndrept atenția puțin mai jos?
Dialogue: 99,0:20:52.78,0:20:55.53,Dialogue,,0,0,0,,Oare vei fi rece și acolo?
Dialogue: 99,0:20:55.53,0:20:57.12,Dialogue,,0,0,0,,Foarte probabil.
Dialogue: 99,0:20:57.66,0:21:01.62,Dialogue,,0,0,0,,Deoarece voi aveți corpurile reci.
Dialogue: 99,0:21:01.62,0:21:03.54,Dialogue,,0,0,0,,Î-Încetează.
Dialogue: 99,0:21:03.54,0:21:04.62,Dialogue,,0,0,0,,Ce încerci să faci?
Dialogue: 99,0:21:04.62,0:21:06.83,Dialogue,,0,0,0,,Nu e evident?
Dialogue: 99,0:21:06.83,0:21:10.00,Dialogue,,0,0,0,,Ai mai auzit până acum \Ncuvântul „casso”?
Dialogue: 99,0:21:10.00,0:21:12.63,Dialogue,,0,0,0,,Înseamnă „a distruge” în latină.
Dialogue: 99,0:21:12.63,0:21:16.55,Dialogue,,0,0,0,,Un cuvânt potrivit \Npentru strigoi și moroi.
Dialogue: 99,0:21:16.55,0:21:20.22,Dialogue,,0,0,0,,Dar mai poate însemna și \Na profana sau a viola.
Dialogue: 99,0:21:21.52,0:21:23.10,Dialogue,,0,0,0,,Așa că bucură-te de ce va urma.
Dialogue: 99,0:21:26.02,0:21:26.90,Dialogue,,0,0,0,,Ce spui de asta?
Dialogue: 99,0:21:26.90,0:21:29.73,Dialogue,,0,0,0,,Scuipatul meu ți-a violat fața?
Dialogue: 99,0:21:32.14,0:21:37.16,Dialogue,,0,0,0,,E un cuvânt perfect pentru gunoaiele \Nca tine care nu vor să moară.
Dialogue: 99,0:21:37.16,0:21:39.24,Dialogue,,0,0,0,,Dumnezeu nu are pic de milă.
Dialogue: 99,0:21:39.24,0:21:42.62,Dialogue,,0,0,0,,A lăsat în seama noastră \Neliminarea gunoaielor ca voi.
Dialogue: 99,0:21:42.62,0:21:44.58,Dialogue,,0,0,0,,Nu contează ce îmi faci!
Dialogue: 99,0:21:44.58,0:21:47.63,Dialogue,,0,0,0,,Chiar dacă mă vei viola, eu nu voi...
Dialogue: 99,0:21:55.38,0:21:58.30,Dialogue,,0,0,0,,D-De ce ești aici?
Dialogue: 99,0:21:58.30,0:22:00.56,Dialogue,,0,0,0,,K-Kishimoto?
Dialogue: 99,0:22:05.14,0:22:06.44,Dialogue,,0,0,0,,De ce?
Dialogue: 99,0:22:07.44,0:22:10.82,Dialogue,,0,0,0,,Te așteptam, moștenitor \Nal descendenței Romuald.
Dialogue: 99,0:22:11.61,0:22:12.90,Dialogue,,0,0,0,,Dle profesor Cliff?
Dialogue: 99,0:22:12.90,0:22:15.45,Dialogue,,0,0,0,,Ce faceți aici?
Dialogue: 99,0:22:15.45,0:22:18.28,Dialogue,,0,0,0,,Să ne grăbim! Trebuie \Ns-o ajutăm pe Kishimoto!
Dialogue: 99,0:22:18.28,0:22:20.62,Dialogue,,0,0,0,,Nu rosti numele acelui gunoi.
Dialogue: 99,0:22:22.97,0:22:24.08,Dialogue,,0,0,0,,Ce înseamnă asta?
Dialogue: 99,0:22:24.44,0:22:26.83,Dialogue,,0,0,0,,Fata aia nu e om.
Dialogue: 99,0:22:26.83,0:22:29.08,Dialogue,,0,0,0,,Nu ai de ce să-ți faci \Ngriji pentru un gândac.
Dialogue: 99,0:22:29.08,0:22:30.29,Dialogue,,0,0,0,,Gândac?
Dialogue: 99,0:22:30.29,0:22:33.00,Dialogue,,0,0,0,,E datoria ta să elimini o astfel de creatură.
Dialogue: 99,0:22:35.05,0:22:37.43,Dialogue,,0,0,0,,Te rog să folosești această sabie.
Dialogue: 99,0:22:37.68,0:22:38.43,Dialogue,,0,0,0,,Haide.
Dialogue: 99,0:22:38.93,0:22:40.22,Dialogue,,0,0,0,,„Eliminare”?
Dialogue: 99,0:22:40.22,0:22:42.76,Dialogue,,0,0,0,,Ce vrei să spui prin asta? \NNu prea înțeleg...
Dialogue: 99,0:22:43.93,0:22:45.52,Dialogue,,0,0,0,,Tânăr și naiv.
Dialogue: 99,0:22:45.85,0:22:50.19,Dialogue,,0,0,0,,Te voi învăța cum să menții \Nordinea socială în această lume.
Dialogue: 99,0:22:50.77,0:22:53.07,Dialogue,,0,0,0,,Ce tot spuneți acolo?
Dialogue: 99,0:22:53.07,0:22:54.28,Dialogue,,0,0,0,,Nimic din toate astea...
Dialogue: 99,0:22:54.28,0:22:55.53,Dialogue,,0,0,0,,Nu-ți face griji.
Dialogue: 99,0:22:55.53,0:22:57.32,Dialogue,,0,0,0,,Te voi ajuta.
Dialogue: 99,0:23:00.11,0:23:02.20,Dialogue,,0,0,0,,Deci, moștenitorule.
Dialogue: 99,0:23:02.78,0:23:05.29,Dialogue,,0,0,0,,Haide s-o facem împreună.
Dialogue: 99,0:23:05.29,0:23:06.66,Dialogue,,0,0,0,,Vă rog să așteptați.
Dialogue: 99,0:23:06.66,0:23:09.04,Dialogue,,0,0,0,,Kishimoto va muri dacă o vom lovi.
Dialogue: 99,0:23:09.04,0:23:10.88,Dialogue,,0,0,0,,Evident că va muri.
Dialogue: 99,0:23:10.88,0:23:12.42,Dialogue,,0,0,0,,Chiar nu e evident?
Dialogue: 99,0:23:12.42,0:23:15.46,Dialogue,,0,0,0,,Îți voi arăta cum rezolvă \Nadulții problemele.
Dialogue: 99,0:23:15.92,0:23:19.47,Dialogue,,0,0,0,,Nu, asta e complet greșit, dle profesor.
Dialogue: 99,0:23:20.18,0:23:21.43,Dialogue,,0,0,0,,Vă rog să-mi dați drumul.
Dialogue: 99,0:23:21.43,0:23:22.80,Dialogue,,0,0,0,,Dați-mi drumul, dle profesor.
Dialogue: 99,0:23:22.80,0:23:23.72,Dialogue,,0,0,0,,Vă rog.
Dialogue: 99,0:23:24.02,0:23:26.72,Dialogue,,0,0,0,,E în regulă. Ea nu este om.
Dialogue: 99,0:23:26.72,0:23:33.44,Dialogue,,0,0,0,,Această sabie de argint o poate ucide \Ncât ai clipi, fără a lăsa vreo urmă.
Dialogue: 99,0:23:34.02,0:23:37.19,Dialogue,,0,0,0,,Nu, dle profesor Cliff. Vă implor.
Dialogue: 99,0:23:37.19,0:23:39.49,Dialogue,,0,0,0,,Opriți-vă. Nu ar trebui \Nsă facem așa ceva.
Dialogue: 99,0:23:39.70,0:23:41.78,Dialogue,,0,0,0,,Nu vreau să ucid pe nimeni!
Dialogue: 99,0:23:41.78,0:23:43.53,Dialogue,,0,0,0,,Ba da. Trebuie.
Dialogue: 99,0:23:43.53,0:23:45.03,Dialogue,,0,0,0,,Pentru un viitor mai bun.
Dialogue: 99,0:23:52.29,0:23:53.96,Dialogue,,0,0,0,,Tocmai s-a trezit.
Dialogue: 99,0:24:03.09,0:24:04.18,Dialogue,,0,0,0,,Nemernicule!
Dialogue: 99,0:24:04.18,0:24:06.89,Dialogue,,0,0,0,,Armele jos. El e descendentul.
Dialogue: 99,0:24:07.96,0:24:09.02,Dialogue,,0,0,0,,Ne vom retrage acum.
Dialogue: 99,0:24:09.02,0:24:10.02,Dialogue,,0,0,0,,Dar cum rămâne cu...
Dialogue: 99,0:24:10.02,0:24:11.52,Dialogue,,0,0,0,,Va decurge așa cum spune legenda...
Dialogue: 99,0:24:11.98,0:24:13.44,Dialogue,,0,0,0,,Retragerea.
Dialogue: 99,0:24:13.77,0:24:16.19,Dialogue,,0,0,0,,Retragerea cât mai repede.
Dialogue: 99,0:24:16.19,0:24:17.03,Dialogue,,0,0,0,,Recepționat.
Dialogue: 99,0:24:17.90,0:24:21.32,Dialogue,,0,0,0,,Asta înseamnă că tocmai ai \Ndevenit adult, descendentule.
Dialogue: 99,0:24:21.95,0:24:23.99,Dialogue,,0,0,0,,Ne vom lua rămas bun deocamdată.
Dialogue: 99,0:24:23.99,0:24:25.45,Dialogue,,0,0,0,,Dar ne vom mai revedea.
Dialogue: 99,0:24:25.45,0:24:26.42,Dialogue,,0,0,0,,{\fad(0,300)}Adio.
Dialogue: 99,0:24:42.45,0:24:44.76,Dialogue,,0,0,0,,Scuze, nu mă voi uita.
Dialogue: 99,0:24:46.76,0:24:47.85,Dialogue,,0,0,0,,Totul e în regulă acum.
Dialogue: 99,0:24:57.36,0:24:58.69,Dialogue,,0,0,0,,Kishimoto,
Dialogue: 99,0:24:58.69,0:25:00.69,Dialogue,,0,0,0,,mă bucur că ești bine.
Dialogue: 99,0:25:01.70,0:25:02.90,Dialogue,,0,0,0,,Îți mulțumesc.
