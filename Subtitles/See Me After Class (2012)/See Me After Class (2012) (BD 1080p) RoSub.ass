Comment: 0,0:00:00.00,0:00:00.02,Dialogue,chptr,0,0,0,,{Prolog}
Comment: 0,0:01:09.05,0:01:09.09,Dialogue,chptr,0,0,0,,{Partea 1}
Comment: 0,0:09:48.07,0:09:48.11,Dialogue,chptr,0,0,0,,{Partea 2}
Comment: 0,0:21:06.79,0:21:06.83,Dialogue,chptr,0,0,0,,{Partea 3}
